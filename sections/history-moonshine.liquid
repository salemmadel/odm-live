<link rel="stylesheet" href="{{ 'section-history-moonshine.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-history-moonshine.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

  }

  .history-moonshine__card__link {
    background-image: url('{{ 'black-bar.png' | file_img_url: '320x' }}')
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding">

  <div class="history-moonshine__card__intro">
    <div class="page-width">
      {{ 'unser-moonshine.png' | file_img_url: '700x' | img_tag: 'Our Moonshine','history-moonshine__img','700x200' }}
      <p >{{ section.settings.text_1 }}</p>
    </div>
  </div>


  <div class="color-background-2">
    <div class="page-width history-moonshine__container"> <!-- container for all Bottles -->
      {%- for block in section.blocks -%}
        {%- liquid assign is_even = forloop.index | modulo: 2 -%}
        {% if forloop.index == 1 %}
          {% assign first_block = block %}
        {% elsif forloop.index == 2 %}  
            {% render 'moonshine-card-first', first_product: first_block.settings, second_product: block.settings %}
            <div class="hidden-lg">
              {% render 'moonshine-card', product_name: first_block.settings.product_name, is_even: is_even, product_headline: first_block.settings.product_headline, product_image: first_block.settings.product_image %}
            </div> 
            <div class="hidden-lg">
              {% render 'moonshine-card', product_name: block.settings.product_name, is_even: is_even, product_headline: block.settings.product_headline, product_image: block.settings.product_image %}
            </div>       
        {%- else -%}
          {% render 'moonshine-card', product_name: block.settings.product_name, is_even: is_even, product_headline: block.settings.product_headline, product_image: block.settings.product_image %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section> 
  
  {% schema %}
  {
    "name": "t:sections.history.moonshine.name",
    "class": "moonshine-top-section",
    "settings": [
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      },
      {
        "type": "text",
        "id": "text_1",
        "label": "t:sections.history.story.text_one"
      }
    ],
    "blocks": [
      {
        "type": "moonshine",
        "name": "t:sections.history.moonshine.blocks.type",
        "settings": [
          {
            "type": "product",
            "id": "product_name",
            "label": "t:sections.history.moonshine.blocks.name"
          },
          {
            "type": "image_picker",
            "id": "product_headline",
            "label": "t:sections.history.moonshine.blocks.name_img"
          },
          {
            "type": "image_picker",
            "id": "product_image",
            "label": "t:sections.history.moonshine.blocks.product_img"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "t:sections.history.moonshine.name",
        "category": "History"
      }
    ]
  }
  {% endschema %}
  