{%- liquid
  assign gutter_class = "g-" | append: section.settings.gutter

  capture column_class
    render "calc-column-class", columns_xs: section.settings.width_mobile, columns_md: section.settings.width_desktop
  endcapture

  assign interval = section.settings.interval | times: 1000 | round
  assign autoplay = section.settings.autoplay_enabled
  assign items = ""
-%}

{%- for block in section.blocks -%}
  {%- capture item -%}
    <div class="position-relative w-100 h-100">
      {%- if block.settings.link != nil -%}
        <a class="d-block" href="{{ block.settings.link }}">
      {%- endif -%}
      {%- render "image",
        image: block.settings.image_mobile,
        image_md: block.settings.image_desktop,
        is_lazy: lazyload
      -%}
      {%- if block.settings.link != nil -%}
        </a>
      {%- endif -%}
    </div>
  {%- endcapture -%}
  {%- assign items = items | append: item | append: "||||" -%}
{%- endfor -%}
{%- assign items = items | split: "||||" -%}

<div data-outer id="{{ section.id }}" class="📐 overflow-hidden" style="background-color: {{ section.settings.background_color }};">
  <div data-inner class="container {{ section.settings.container }} {{ margins_class }}">
    <div data-content>
      {%- render "swiper"
        gutter_class: gutter_class,
        slide_class: column_class,
        items: items,
        loop: true,
        lazyload: false,
        navigation_enabled: true,
        autoplay_enabled: autoplay,
        interval: interval
      -%}
    </div>
  </div>
</div>

