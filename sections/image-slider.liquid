<style>
.image-text-slider-section .slider {
  position: relative;
  overflow: hidden;
}

.image-text-slider-section{
    padding-top: 18px;
    padding-bottom: 18px;
}

.image-text-slider-section .slide {
  display: none;
}

.image-text-slider-section .slide.is-active {
  display: block;
}

.image-text-slider-section .slide-content {
  display: flex;
  width: 100%;
}

.image-text-slider-section .image-container {
  flex: 1;
  position: relative;
  overflow: hidden;
 
}

.image-text-slider-section .slider-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.image-text-slider-section .image-container:hover .slider-image {
  transform: scale(1.03);
}

.image-text-slider-section .text-container {
  flex: 1;
  padding: 6rem 7rem 7rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.image-text-slider-section .slider-title {
  font-size: 17px;
  font-weight: 700;
  margin-top: 6px;
  margin-bottom: 6px;
  line-height: 1.2;
  color: black;
}

.image-text-slider-section .slider-text {
  font-size: 16px;
  line-height: 1.6;
  margin-bottom: 30px;
  color: #495057;
}

.image-text-slider-section .slider-text p {
  margin-bottom: 15px;
}

.image-text-slider-section .slider-button {
  display: inline-block;
  padding: 12px 32px;
  background-color: #000;
  color: #fff;
  text-decoration: none;
  border-radius: 30px;
  font-weight: 600;
  transition: all 0.3s ease;
  border: 2px solid #000;
  width: fit-content;
}

.image-text-slider-section .slider-button:hover {
  background-color: transparent;
  color: #000;
  transform: translateY(-2px);
}

/* New: Navigation Arrows positioned inside the slider */
.image-text-slider-section .slider-controls { 
  position: absolute;
  top: 96%;
  transform: translateY(-50%);
  width: 100%;
  padding: 0 20px;
  gap: 2rem;
  display: flex;
  justify-content: right;
  align-items: center;
  z-index: 10;
  pointer-events: none; /* Allows clicks to pass through wrapper to buttons */
}

/* Hide original navigation container and dots */
.image-text-slider-section .slider-navigation, 
.image-text-slider-section .slider-dots {
  display: none !important; 
}

/* Arrow styling */
.image-text-slider-section .slider-arrow {
  background: none;
  border: none;
  cursor: pointer;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: black;
  color: white;
  transition: all 0.2s ease;
  pointer-events: auto; /* Re-enable clicks on the buttons */
}

.image-text-slider-section .slider-arrow:hover {
  transform: scale(1.1);
}

.image-text-slider-section .slider-arrow svg {
  width: 20px;
  height: 20px;
  fill: black;
}


/* Responsive */
@media screen and (max-width: 900px) {
  .slide-content {
    flex-direction: column;
  }
  
  .image-container {
    min-height: 300px;
  }
  
  .text-container {
    padding: 40px 30px;
  }
  
  .slider-title {
    font-size: 1.8rem;
  }
}

@media screen and (max-width: 600px) {
  .text-container {
    padding: 30px 20px;
  }
  .image-text-slider-section {
  padding: 1.5rem 0 1.5rem;
}

.image-text-slider-section .text-container{
  padding: 15px 20px 27px;
} 
  .slider-title {
    font-size: 1.6rem;
  }
  
  .slider-text {
    font-size: 1rem;
  }
  
  .slider-controls {
    padding: 0 10px; /* Adjust padding on mobile */
  }
  
  .slider-arrow {
    width: 36px;
    height: 36px;
  }
  
  .slider-arrow svg {
    width: 16px;
    height: 16px;
  }
}
</style>

<section class="image-text-slider-section page-width" data-section-id="{{ section.id }}">
  <div class="slider" data-slider>
    {% for block in section.blocks %}
      <div class="slide" data-slide>
        <div class="slide-content">
          <div class="image-container">
            {%- if block.settings.image -%}
              {%- assign image_url = block.settings.image | img_url: 'master' -%}
              <img class="slider-image"
                   src="{{ image_url }}"
                   srcset="{{ block.settings.image | img_url: '600x' }} 600w,
                           {{ block.settings.image | img_url: '800x' }} 800w,
                           {{ block.settings.image | img_url: '1200x' }} 1200w"
                   sizes="(min-width: 900px) 50vw, 100vw"
                   loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                   alt="{{ block.settings.image.alt | escape }}"
                   width="{{ block.settings.image.width }}"
                   height="{{ block.settings.image.height }}">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="text-container">
            {%- if block.settings.title != blank -%}
              <h2 class="slider-title">{{ block.settings.title | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="slider-text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a href="{{ block.settings.button_link }}" class="slider-button btn">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {% endfor %}

    {% comment %} Arrow controls moved inside the slider for absolute positioning. No dot element included. {% endcomment %}
    {% if section.blocks.size > 1 %}
      <div class="slider-controls"> 
        <button type="button" class="slider-arrow slider-prev" data-slider-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="slider-arrow slider-next" data-slider-next aria-label="{{ 'general.slider.next_slide' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>

  {% comment %} Original slider-navigation container is now hidden via CSS {% endcomment %}
</section>

<script>
(function() {
  // Only run if this section exists on the page
  const section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;
  
  const slider = section.querySelector('[data-slider]');
  if (!slider) return;
  
  const slides = slider.querySelectorAll('[data-slide]');
  if (slides.length <= 1) return;
  
  // const dotsContainer = section.querySelector('[data-slider-dots]'); // Commented out: Not used
  const prevBtn = section.querySelector('[data-slider-prev]');
  const nextBtn = section.querySelector('[data-slider-next]');
  
  let currentIndex = 0;
  let autoRotate;
  
  // Commented out: Dot creation logic removed
  /*
  if (dotsContainer) {
    dotsContainer.innerHTML = '';
    slides.forEach((_, index) => {
      const dot = document.createElement('button');
      dot.classList.add('slider-dot');
      dot.setAttribute('type', 'button');
      dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
      if (index === 0) dot.classList.add('is-active');
      dot.addEventListener('click', () => goToSlide(index));
      dotsContainer.appendChild(dot);
    });
  }
  */
  
  // Set first slide as active
  slides[0].classList.add('is-active');
  
  // Navigation function
  function goToSlide(index) {
    // Remove active class from all slides
    slides.forEach(slide => slide.classList.remove('is-active'));
    
    // Commented out: Dot logic removed
    /*
    if (dotsContainer) {
      const dots = dotsContainer.querySelectorAll('.slider-dot');
      dots.forEach(dot => dot.classList.remove('is-active'));
    }
    */
    
    // Handle index wrapping
    if (index >= slides.length) {
      currentIndex = 0;
    } else if (index < 0) {
      currentIndex = slides.length - 1;
    } else {
      currentIndex = index;
    }
    
    // Add active class to current slide
    slides[currentIndex].classList.add('is-active');
    
    // Commented out: Dot logic removed
    /*
    if (dotsContainer) {
      dotsContainer.children[currentIndex].classList.add('is-active');
    }
    */
  }
  
  // Event listeners
  if (prevBtn) {
    prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));
  }
  
  // Commented out: Dot listener removed
  /*
  if (dotsContainer) {
    dotsContainer.addEventListener('click', (e) => {
      if (e.target.classList.contains('slider-dot')) {
        const index = Array.from(dotsContainer.children).indexOf(e.target);
        goToSlide(index);
      }
    });
  }
  */
  
  // Auto rotate
  function startAutoRotate() {
    autoRotate = setInterval(() => {
      goToSlide(currentIndex + 1);
    }, 5000);
  }
  
  {% comment %} function stopAutoRotate() {
    if (autoRotate) {
      clearInterval(autoRotate);
    }
  }
  
  startAutoRotate(); {% endcomment %}
  
  // Pause on hover
  slider.addEventListener('mouseenter', stopAutoRotate);
  slider.addEventListener('mouseleave', startAutoRotate);
  
  // Keyboard navigation
  slider.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      goToSlide(currentIndex + 1);
    } else if (e.key === 'ArrowLeft') {
      goToSlide(currentIndex - 1);
    }
  });
  
  // Cleanup function for theme editor
  window.addEventListener('shopify:section:unload', (event) => {
    if (event.detail.sectionId === '{{ section.id }}') {
      stopAutoRotate();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Image with text slider",
  "tag": "section",
  "class": "image-text-slider-section",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Share details about your brand with customers. Add text to describe your products, services, or any other information you want to share.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Button text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}