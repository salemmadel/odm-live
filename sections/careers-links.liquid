<link rel="stylesheet" href="{{ 'careers-links.css' | asset_url }}" media="print" onload="this.media='all'">

 <div class="careers-links-sec--{% if section.settings.color_scheme %} color-{{ section.settings.color_scheme }} gradient{% endif %} section-{{ section.id }}-padding">
    <h2 class="careers-links-title">{{ section.settings.title }}</h2>
    <div class="careers-links-container page-width">
 
      {% for block in section.blocks %}
      {% assign oddeven = forloop.index | modulo: 2 %}
      <div class="career {% if oddeven == 0 %} even {% else %} odd {% endif %}" >
       {% if block.settings.link == blank %}
         {% assign link = section.settings.default %}
       {% else %}
         {% assign link = block.settings.link %}
       {% endif %}
         <a class="career-link" href="{{ link }}">
          {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 3840 | image_tag: widths: '550, 720, 990, 1100, 1500, 2200, 3000, 3840', alt: block.settings.image.alt, loading: 'lazy', draggable: 'false', class: 'career-image' }} 
            {%- endif -%}
         </a>
       </div>
       {% endfor %}
     </div>
   </div>
 </div>
 
 {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} h2  {
    color: {{ section.settings.text_color }};
  }
{%- endstyle -%}

 
 <script>
   document.addEventListener( 'DOMContentLoaded', function () {
 
     const observer = new IntersectionObserver(entries => {
       entries.forEach(entry => {
 
         if (entry.isIntersecting) {
           if(entry.target.classList.contains('even'))
           entry.target.classList.add('scroll-animate-career-right');
           else
           entry.target.classList.add('scroll-animate-career-left');
         return; // if we added the class, exit the function
         }
 
         // We're not intersecting, so remove the class!
         entry.target.classList.remove('scroll-animate-career-left');
         entry.target.classList.remove('scroll-animate-career-right');
       });
     });
     
     const careers = document.querySelectorAll('.career');
     careers.forEach( career => {
       observer.observe(career);
     })
 
   });
 </script>
 
 
 {% schema %}
 {
   "name": "t:sections.career-categories.name",
   "class": "section",
   "settings": [
     {
       "type": "text",
       "id": "title",
       "label": "t:sections.career-categories.settings.title.label"
     },
     
     {
       "type": "text",
       "id": "default",
       "label": "t:sections.career-categories.settings.link.label"
     },
     {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.career-categories.settings.background_color.label",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.career-categories.settings.text_color.label",
      "default": "#000"
    },
     {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        },
        {
          "value": "transparent",
          "label": "transparent"
        }
      ],
      "default": "accent-2",
      "label": "t:sections.all.colors.label"
    },
     {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
     
   ],
   "blocks": [
   {
     "type": "t:sections.career-categories.blocks.image.type",
     "name": "t:sections.career-categories.blocks.image.name",
     "settings": [
       {
         "type": "text",
         "id": "link",
         "label": "t:sections.career-categories.blocks.image.settings.link.label"
       },
       {
         "type": "image_picker",
         "id": "image",
         "label": "t:sections.career-categories.blocks.image.settings.cover.label"
       }
     ]
   }
 ],
   "presets": [
     {
       "name": "t:sections.career-categories.presets.name",
       "category": "Image"
     }
   ]
 }
 {% endschema %}
 