{%- style -%}
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  @media screen and (min-width: 990px) {
    header-drawer {
      display: none;
    }
  }

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
    align-items:center;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  .section-header {
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  {% if settings.enable_header_group %}
  .mega-menu__content {
    z-index: 2 !important;
  }
  {% endif %}

  /* Header transparency and color settings */
  {%- liquid
    assign is_homepage = false
    assign is_collection_page = false
    assign is_product_page = false
    assign should_be_transparent = false

    if template == 'index'
      assign is_homepage = true
    endif

    if template contains 'collection'
      assign is_collection_page = true
    endif

    if template contains 'product'
      assign is_product_page = true
    endif

    if is_homepage and section.settings.enable_transparent_header_homepage
      assign should_be_transparent = true
    elsif is_collection_page and section.settings.enable_transparent_header_collections
      assign should_be_transparent = true
    elsif is_product_page == false and is_collection_page == false and is_homepage == false and section.settings.enable_transparent_header_other
      assign should_be_transparent = true
    endif
  -%}

  {% if should_be_transparent %}
    .header-wrapper {
      position: absolute;
      width: 100%;
      background: transparent !important;
      z-index: 3;
    }

    /* Add spacing to content below transparent header to prevent overlap */
    .header-wrapper ~ .shopify-section,
    .header-wrapper ~ * .shopify-section:first-child {
      padding-top: calc(var(--header-height, 6rem) + 2rem);
    }

    @media screen and (max-width: 749px) {
      .header-wrapper ~ .shopify-section,
      .header-wrapper ~ * .shopify-section:first-child {
        padding-top: calc(var(--header-height, 5rem) + 1rem);
      }
    }

    .header-wrapper .header__heading-link,
    .header-wrapper .header__menu-item,
    .header-wrapper .list-menu__item,
    .header-wrapper .header__icon,
    .header-wrapper svg,
    .header-wrapper .link {
      color: {{ section.settings.transparent_header_text_color }} !important;
    }

    .header-wrapper .icon {
      fill: {{ section.settings.transparent_header_text_color }} !important;
      stroke: {{ section.settings.transparent_header_text_color }} !important;
    }

    /* Ensure dropdown menus still have proper backgrounds */
    .header__submenu,
    .mega-menu__content {
      background: {{ section.settings.header_background_color }} !important;
    }

    .header__submenu .header__menu-item,
    .mega-menu__content .mega-menu__link {
      color: inherit !important;
    }
  {% else %}
    .header-wrapper {
      background-color: {{ section.settings.header_background_color }} !important;
    }
  {% endif %}
{%- endstyle -%}

