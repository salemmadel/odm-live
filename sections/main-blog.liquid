{%- if section.settings.is_above_the_fold -%}
  {{ 'component-article-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{%- else -%}
  <link
    rel="stylesheet"
    href="{{ 'component-article-card.css' | asset_url }}"
    media="print"
    onload="this.media='all'">
  <link
    rel="stylesheet"
    href="{{ 'component-card.css' | asset_url }}"
    media="print"
    onload="this.media='all'">
  <link
    rel="stylesheet"
    href="{{ 'section-main-blog.css' | asset_url }}"
    media="print"
    onload="this.media='all'">

  <noscript>
    {{ 'component-article-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    {{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
  </noscript>

{%- endif -%}

<script src="{{ 'slider-nav.js' | asset_url }}" defer="defer"></script>

{% if section.settings.show_excerpt_full %}
  <script>
    document.addEventListener("DOMContentLoaded", function(event) {
      var arrows = document.querySelectorAll(".card__information__more")
      for (const arrow of arrows) {
        arrow.addEventListener('click', function(event) {
          var target = event.currentTarget || event.srcElement
          var container = target
            .parentElement
            .querySelector('.card__information')
            container
            .classList
            .toggle('card__information--open')
          target
          .classList
          .toggle('card__information__more--active')
      })
    }
  });
  </script>
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}
    px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}
    px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}
      px;
      padding-bottom: {{ section.settings.padding_bottom }}
      px;
    }
  }

  {% if section.settings.show_excerpt_full %}
    .card__information {
      max-height: 10rem;
      overflow: hidden;
      transition: 0.5s max-height;
    }

    .card__information--open {
      max-height: 50rem;
      overflow-y: scroll;
    }

    .card__information__more {
      width: 100%;
      grid-row-start: 3;
      text-align: center;
      position: relative;
      z-index: 1;
    }

    .card__information__more > svg {
      margin-top: 1rem;
      height: 2.5rem;
      width: 2.5rem;
      transition: 0.5s transform;
    }

    .card__information__more--active > svg {
      transform: rotate(180deg);
    }

  {% endif %}
{%- endstyle -%}

{%- if section.settings.cocktails_blog -%}
  {%- assign blog_articles_count = 8 -%}
{%- else -%}
  {%- assign blog_articles_count = 6 -%}
{%- endif -%}

{%- paginate blog.articles by blog_articles_count -%}
  <div class="main-blog page-width section-{{ section.id }}-padding wrapper">
    {%- if section.settings.show_title -%}
      <h1 class="title--primary">{{ blog.title | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.show_tags_for_filter -%}
      <slider-nav>
        <div data-slide-left class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce">
          {% render 'icon-caret' %}
        </div>
        <div class="tag-sorting ">
          <a class="button button--primary" href="{{ blog.url }}">{{ 'blogs.article.filter_all_sorts' | t }}</a>
          {%- for tag in blog.all_tags -%}


            {% assign tag_handle = tag | handle %}

            {% assign blog_tag = "/tagged/" | append: tag_handle %}

            <a
              class="button button--primary item
              {% if request.path contains blog_tag %}
                button--active
              {% endif %}"
              href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>


          {%- endfor -%}
        </div>
        <div data-slide-right class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce">
          {% render 'icon-caret' %}
        </div>
      </slider-nav>
    {%- endif -%}

    <div
      class="blog-articles {% if section.settings.layout == 'collage' %}blog-articles--collage{% endif %}">
      {%- for article in blog.articles -%}

        <div class="blog-articles__article article">
          {%- render 'article-card'
            , article: article,
            media_height: section.settings.image_height,
            media_aspect_ratio: article.image.aspect_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: section.settings.show_excerpt,
            show_excerpt_full: section.settings.show_excerpt_full -%}
        </div>

      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{%- if section.settings.cocktails_blog -%}
  {%- style -%}
    @media screen and (min-width: 320px) {
      .blog-articles {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    @media screen and (min-width: 750px) {
      .blog-articles {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media screen and (min-width: 998px) {
      .blog-articles {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media screen and (min-width: 1200px) {
      .blog-articles {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
  {
    "name": "t:sections.main-blog.name",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "is_above_the_fold",
        "label": "is Above the Fold",
        "default": false,
        "info": "Check if Content is loaded first to eliminate CLS"
      },
      {
        "type": "checkbox",
        "id": "show_tags_for_filter",
        "label": "Show Tags for Filter",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_title",
        "label": "Show Blog Title",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cocktails_blog",
        "label": "Blog is for Cocktails",
        "default": false
      },
      {
        "type": "header",
        "content": "t:sections.main-blog.settings.header.content"
      }, 
      {
        "type": "select",
        "id": "layout",
        "options": [
          {
            "value": "grid",
            "label": "t:sections.main-blog.settings.layout.options__1.label"
          }, {
            "value": "collage",
            "label": "t:sections.main-blog.settings.layout.options__2.label"
          }
        ],
        "default": "collage",
        "label": "t:sections.main-blog.settings.layout.label",
        "info": "t:sections.main-blog.settings.layout.info"
      }, {
        "type": "checkbox",
        "id": "show_image",
        "default": true,
        "label": "t:sections.main-blog.settings.show_image.label"
      }, {
        "type": "select",
        "id": "image_height",
        "options": [
          {
            "value": "adapt",
            "label": "t:sections.main-blog.settings.image_height.options__1.label"
          }, {
            "value": "small",
            "label": "t:sections.main-blog.settings.image_height.options__2.label"
          }, {
            "value": "medium",
            "label": "t:sections.main-blog.settings.image_height.options__3.label"
          }, {
            "value": "large",
            "label": "t:sections.main-blog.settings.image_height.options__4.label"
          }
        ],
        "default": "medium",
        "label": "t:sections.main-blog.settings.image_height.label",
        "info": "t:sections.main-blog.settings.image_height.info"
      }, {
        "type": "checkbox",
        "id": "show_date",
        "default": true,
        "label": "t:sections.main-blog.settings.show_date.label"
      }, {
        "type": "checkbox",
        "id": "show_author",
        "default": false,
        "label": "t:sections.main-blog.settings.show_author.label"
      }, {
        "type": "checkbox",
        "id": "show_excerpt",
        "default": false,
        "label": "t:sections.main-blog.settings.show_excerpt.label"
      }, {
        "type": "checkbox",
        "id": "show_excerpt_full",
        "default": false,
        "label": "t:sections.main-blog.settings.show_excerpt_full.label"
      }, {
        "type": "paragraph",
        "content": "t:sections.main-blog.settings.paragraph.content"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ]
  }
{% endschema %}