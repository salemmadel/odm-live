{%- if section.settings.is_above_the_fold -%}
    {{ 'countdown-timer.css' | asset_url | stylesheet_tag: preload: true }}
{%- else -%}
    <link rel="stylesheet" href="{{ 'countdown-timer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif  -%}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

.timer {
    background: {{ section.settings.background_color }};
}

.timer > div, .countdown__number .old, .countdown__number .new, .countdown__number .current  {
    color: {{ section.settings.text_color }};
}
{% if section.settings.box_order == "above" %}
    .timer-container{
        order: 2;
    }
{%- endif -%}

{%- endstyle -%}

<script src="{{ 'timer.js' | asset_url }}" defer="defer"></script>


<section class="timer section-{{ section.id }}-padding">
    <div class="timer-container">
        <div data-countdown="{{section.settings.timer}}" id="countdown-container"  class="countdown__container" data-confetti="{{ section.settings.enable_confetti }}">
            <div><div id="js-days"class="countdown__number countdown__days"></div> <span class="countdown__tag">{{'general.time.DYS' | t}}</span></div>
            <div id="js-separator" class="separator">:</div>
            <div><div id="js-hours" class="countdown__number countdown__hours"></div> <span class="countdown__tag">{{'general.time.HRS' | t}}</span></div>
            <div id="js-separator" class="separator">:</div>
            <div><div id="js-minutes" class="countdown__number countdown__minutes"></div><span class="countdown__tag">{{'general.time.MIN' | t}}</span></div>
            <div id="js-separator" class="separator">:</div>
            <div><div id="js-seconds" class="countdown__number countdown__seconds"></div><span class="countdown__tag" >{{'general.time.SEC' | t}}</span></div>
        </div>
    </div>
    <div class="timer__info">
        {%- if section.settings.info != blank -%}
            <div class="timer__info-text" >
              <span>{{ section.settings.info | escape }}</span>
            </div>
          {%- endif -%}
    </div>
  </section>

  <script>
    window.addEventListener("load", (event) => {
      var slideshows = document.querySelectorAll('[data-countdown]')
        slideshows.forEach(slideshow => {
          var timer = new Timer(slideshow)
          timer.run()
        })
      });
    
  </script>
  
  
  {% schema %}
  {
    "name": "t:sections.countdown_timer.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "is_above_the_fold",
            "label": "is Above the Fold",
            "default": false,
            "info": "Check if Content is loaded first to eliminate CLS"
        },
        {
            "type": "text",
            "id": "timer",
            "label": "t:sections.countdown_timer.settings.timer.label",
            "info": "t:sections.countdown_timer.settings.timer.info"
        },
        {
            "type": "text",
            "id": "info",
            "default": "Something Exciting is Coming…",
            "label": "t:sections.countdown_timer.settings.info.label"
        },
        {
            "type": "select",
            "id": "box_order",
            "label": "t:sections.countdown_timer.settings.box_order.label",
            "options":[
                {
                    "value": "above",
                    "label": "t:sections.countdown_timer.settings.box_order.options__1.label"
                },
                {
                    "value": "below",
                    "label": "t:sections.countdown_timer.settings.box_order.options__2.label"
                }
            ],
            "default": "below"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "t:sections.countdown_timer.settings.background_color.label",
            "default": "#fff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "t:sections.countdown_timer.settings.text_color.label",
            "default": "#000"
        },
        {
            "type": "checkbox",
            "id": "enable_confetti",
            "label": "t:sections.countdown_timer.settings.enable_confetti.label",
            "default": true
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 40
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 52
          }
    ],
    "presets": [
      {
        "name": "t:sections.countdown_timer.presets.name"
      }
    ]
  }
  {% endschema %}