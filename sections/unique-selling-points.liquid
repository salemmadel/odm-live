<section
  class="content-container content-container--full-width isolate section-{{ section.id }}-padding"
  id="section-{{ section.id }}"
>
  {%- if section.settings.subheading != blank or section.settings.title != blank -%}
    <header class="center">
      {%- if section.settings.title != blank -%}
        <h2 class="title--primary">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <h3>{{ section.settings.subheading | escape }}</h3>
      {%- endif -%}


    </header>
  {%- endif -%}

  <div class="eshop-guide__unique-selling-point-container">
    {%- for block in section.blocks -%}
      {%- if block.settings.image.src != blank or block.settings.title != blank or block.settings.text != blank -%}
        <div class="eshop-guide__unique-selling-point-item">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 200 | image_tag: alt: block.settings.image.alt, class: 'item__img lazyload', widths: '200, 550, 700', aspectratio: block.settings.image.aspect_ratio, loading: 'lazy' }}
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="eshop-guide__unique-selling-point-title u-h3">
              <strong>{{ block.settings.title }}</strong>
            </h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="u-h4">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size }}px;
  }
  #section-{{ section.id }} .eshop-guide__unique-selling-point-title{
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
  }
  #section-{{ section.id }} .eshop-guide__unique-selling-point-item:last-child {
    margin-bottom: 0;
  }
  #section-{{ section.id }} .eshop-guide__unique-selling-point-item img {
    background-color: {{ section.settings.background_color_icons }};
    object-fit: contain;
    width: {{ section.settings.items_icon_size }}px;
    height: {{ section.settings.items_icon_size }}px;
  }
    #section-{{ section.id }} .eshop-guide__unique-selling-point-item {
      flex: 1 1 {{ 100 | divided_by: section.settings.small_items_per_row }}%;
    }
    #section-{{ section.id }} .eshop-guide__unique-selling-point-item img {
      width: {{ section.settings.small_items_icon_size }}px;
      height: {{ section.settings.small_items_icon_size }}px;
    }
    {%- if section.settings.small_items_per_row == 1 -%}
      #section-{{ section.id }} .eshop-guide__unique-selling-point-item:last-child {
        margin-bottom: 0;
      }
    {%- endif -%}
  
  @media screen and (min-width: 750px) {
    #section-{{ section.id }} .eshop-guide__unique-selling-point-item {
      flex: 1 1 {{ 100 | divided_by: section.settings.medium_items_per_row }}%;
    }
    #section-{{ section.id }} .eshop-guide__unique-selling-point-item img {
      width: {{ section.settings.medium_items_icon_size }}px;
      height: {{ section.settings.medium_items_icon_size }}px;
    }
    {%- if section.settings.medium_items_per_row == 1 -%}
      #section-{{ section.id }} .eshop-guide__unique-selling-point-item:last-child {
        margin-bottom: 0;
      }
    {%- endif -%}
  }
  @media screen and (min-width: 992px) {
    #section-{{ section.id }} .eshop-guide__unique-selling-point-item {
      flex: 1 1 {{ 100 | divided_by: section.settings.desktop_items_per_row }}%;
    }
    #section-{{ section.id }} .eshop-guide__unique-selling-point-item img {
      width: {{ section.settings.desktop_items_icon_size }}px;
      height: {{ section.settings.desktop_items_icon_size }}px;
    }
    {%- if section.settings.desktop_items_per_row == 1 -%}
      #section-{{ section.id }} .eshop-guide__unique-selling-point-item:last-child {
        margin-bottom: 0;
      }
    {%- endif -%}
  }
</style>

{% schema %}
{
  "name": "Unique Selling Point",
  "class": "unique-selling-point shopify-section--bordered",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-heading",
      "default": "Sub-heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Title"
    },
    {
      "type": "color",
      "id": "background_color_icons",
      "label": "Background color of icons",
      "default": "#ffffff"
    },
    {
      "type": "number",
      "id": "small_items_per_row",
      "label": "Items per row (Mobile)",
      "default": 1,
      "info": "Small Devices"
    },
    {
      "type": "range",
      "id": "small_items_icon_size",
      "label": "Icon Size (Mobile)",
      "default": 60,
      "max": 140,
      "min": 40,
      "info": "Small Devices"
    },
    {
      "type": "number",
      "id": "medium_items_per_row",
      "label": "Items per row (Tablet)",
      "default": 2,
      "info": "Medium Devices"
    },
    {
      "type": "range",
      "id": "medium_items_icon_size",
      "label": "Icon Size (Tablet)",
      "default": 60,
      "max": 160,
      "min": 60,
      "info": "Medium Devices"
    },
    {
      "type": "number",
      "id": "desktop_items_per_row",
      "label": "Items per row (Desktop)",
      "default": 4,
      "info": "Large Devices"
    },
    {
      "type": "range",
      "id": "desktop_items_icon_size",
      "label": "Icon Size (Desktop)",
      "default": 80,
      "max": 180,
      "min": 80,
      "info": "Large Devices"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#eaeaea"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Item Title Color",
      "default": "#000"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Title Font size",
      "default": 20
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color of description",
      "default": "#000"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Font size of description",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "unique_selling_point",
      "name": "t:sections.unique-selling-point.blocks.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Unique Selling Point",
      "name": "Unique Selling Point",
      "settings": {},
      "blocks": [
        {
          "type": "unique_selling_point"
        },
        {
          "type": "unique_selling_point"
        },
        {
          "type": "unique_selling_point"
        }
      ]
    }
  ]
}
{% endschema %}
