<link rel="stylesheet" href="{{ 'section-moonshine-shop.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-moonshine-shop.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
{%- endstyle -%}

<section class="section-{{ section.id }}-padding">
  {{ 'unser-moonshine-negative.png' | file_img_url: '1000x' | img_tag: '','moonshine__title','1000x300' }}
  <div class="page-width">
    <div class="moonshine__container"> <!-- container for all Bottles -->
      {%- for block in section.blocks -%}
      {%- liquid
        assign is_even = forloop.index | modulo: 2
      -%}
      <div class="color-accent-2">
        {% render 'moonshine-card-shop', product_name: block.settings.product_name, product_headline: block.settings.product_headline, product_image: block.settings.product_image, product_text: block.settings.product_text, is_even: is_even %}
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection-moonshine.presets.name",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "moonshine",
      "name": "t:sections.collection-moonshine.blocks.name",
      "settings": [
        {
          "type": "product",
          "id": "product_name",
          "label": "t:sections.collection-moonshine.blocks.name"
        },
        {
          "type": "image_picker",
          "id": "product_headline",
          "label": "t:sections.collection-moonshine.blocks.title"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "t:sections.collection-moonshine.blocks.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-moonshine.presets.name",
      "blocks": [
          {
          "type": "moonshine"
          }
      ]
    }
  ]
}
{% endschema %}