<link rel="stylesheet" href="{{ 'section-history-story.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-history-story.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

  }

  .history-moonshine__spike {
    background-image: url('{{ 'circle.png' | file_img_url: '700x' }}');
  }
{%- endstyle -%}

<div class="history-story__container--upper">
  <div class="history-story__container page-width">
    <div>
      <h3>{{ section.settings.text_1 }}</h3>
      {{section.settings.text_2}}
    </div>
    <div>
      {% if section.settings.image_one %}
        {{ section.settings.image_one | image_url: width: 700 | image_tag: class: 'history-story__img--polaroids', widths: '550, 700' }}
      {% endif %}
    </div>
  </div>
</div>

<div class="history-story__container history-story__container--spike history-story__container--lower page-width">
  <div>
    {% if section.settings.image_two %}
    {{ section.settings.image_two | image_url: width: 700 | image_tag:  class: 'history-story__img--polaroid', widths: '550, 700' }}
  {% endif %}
  </div>
  <div>
    <span class="history-story--place-end">
      <h3>{{section.settings.text_3}}</h3>
      {{section.settings.text_4}}
    </span>
  </div>
</div>

  {% schema %}
  {
    "name": "t:sections.history.story.name",
    "settings": [
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      },
      {
        "type": "text",
        "id": "text_1",
        "label": "t:sections.history.story.text_one"
      },
      {
        "type": "richtext",
        "id": "text_2",
        "label": "t:sections.history.story.text_two"
      },
      {
        "type": "text",
        "id": "text_3",
        "label": "t:sections.history.story.text_three"
      },
      {
        "type": "richtext",
        "id": "text_4",
        "label": "t:sections.history.story.text_four"
      },
      {
      "type": "image_picker",
      "id": "image_one",
      "label": "t:sections.history.story.image_one"
    },
    {
      "type": "image_picker",
      "id": "image_two",
      "label": "t:sections.history.story.image_two"
    }
    ],
    "presets": [
      {
        "name": "t:sections.history.story.name",
        "category": "Store information"
      }
    ]
  }
  {% endschema %}
  