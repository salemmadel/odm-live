<link rel="stylesheet" href="{{ 'gang.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'gang.css' | asset_url | stylesheet_tag }}</noscript>

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% javascript %}
  const prevBtn = document.querySelector('.slider-button--prev');
  const nextBtn = document.querySelector('.slider-button--next');

  prevBtn.addEventListener("click", function(event) {
    const content = document.querySelector('.lion-rewards-list');
    content.scrollLeft -= 250;
    event.preventDefault();
  });

  nextBtn.addEventListener("click", function(event) {
    const content = document.querySelector('.lion-rewards-list');
    content.scrollLeft += 250;
    event.preventDefault();
  });
  
{% endjavascript %}

<section class=" section-{{ section.id }}-padding gang__products page-width ">
  <span class="h2 h2--with-circle" style="background-image: url('{{ 'circle.png' | file_img_url: '700x' }}')">{{ 'gang.products' | t }}</span>
    <div class="slider-rewards__wrapper">
        <div class="slider-rewards" data-lion-rewards-list></div> 
        <div class="slider-rewards__buttons {% if section.settings.disable_arrows_mobile %} slider-rewards__buttons-mobile {% endif %} ">
          <button type="button"  class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">{% render 'icon-caret' %}</button>
          <button type="button"  class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">{% render 'icon-caret' %}</button>
        </div>
  </div>
</section>

{% schema %}
{
  "name": "Gang Rewards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "checkbox",
      "id": "disable_arrows_mobile",
      "label": "t:sections.gang-rewards.settings.disable_arrows_mobile.label",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Gang Rewards"
    }
  ]
}
{% endschema %}
