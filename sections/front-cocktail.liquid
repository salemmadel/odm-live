<link rel="stylesheet" href="{{ 'section-cocktail.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-cocktail.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .cocktail__content {
    background-image: url('{{ 'black-paint.png' | file_img_url: '1500x' }}');
  background-image: -webkit-image-set(
    url(icon1x.png'{{ 'black-paint.png' | file_img_url: '1500x' }}') 1x,
    url('{{ 'black-paint.png' | file_img_url: '700x' }}') 2x
  );
  background-image: image-set(
    url('{{ 'black-paint.png' | file_img_url: '1500x' }}') 1x,
    url('{{ 'black-paint.png' | file_img_url: '700x' }}') 2x
  );
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section data-section-id="{{ section.id }}" class="section-{{ section.id }}-padding cocktail">
  <div class="cocktail__container">
  <div>
    {% liquid 
      assign cocktail-mob = 'cocktail-mobile.png'
      assign mob_100x = cocktail-mob | file_img_url: '100x'
      assign mob_200x = cocktail-mob | file_img_url: '200x'
      assign mob_300x = cocktail-mob | file_img_url: '300x'
      assign mob_400x = cocktail-mob | file_img_url: '400x'
      assign mob_750x = cocktail-mob | file_img_url: '750x'
     %}

    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ cocktail-mob | file_img_url: '700x' }}"
      loading="lazy"
  aspectratio="0.6" 
      sizes="auto" 
data-srcset="{{ mob_100x }} 100w,
             {{ mob_200x }} 200w,
             {{ mob_300x }} 300w,
             {{ mob_400x }} 400w,
             {{ mob_750x }} 750w"
width="700" height="300"
      alt="cocktail" class="cocktail__img cocktail--mobile lazyload" >
    
      {% liquid 
        assign cocktail_desk = 'cocktail-desktop.png' 
        assign desk_100x = cocktail_desk | file_img_url: '100x'
        assign desk_200x = cocktail_desk | file_img_url: '200x'
        assign desk_300x = cocktail_desk | file_img_url: '300x'
        assign desk_400x = cocktail_desk | file_img_url: '400x'
        assign desk_750x = cocktail_desk | file_img_url: '750x'
        assign desk_1100x = cocktail_desk | file_img_url: '1100x'
        assign desk_1500x = cocktail_desk | file_img_url: '1500x'
        assign desk_1780x = cocktail_desk | file_img_url: '1780x'
        assign desk_2000x = cocktail_desk | file_img_url: '2000x'
       %}


    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ cocktail_desk | file_img_url: '1400x' }}"
      loading="lazy"
  aspectratio="2.4" 
      sizes="auto" 
data-srcset="{{ desk_100x }} 100w,
             {{ desk_200x }} 200w,
             {{ desk_300x }} 300w,
             {{ desk_400x }} 400w,
             {{ desk_750x }} 750w,
             {{ desk_1100x }} 1100w,
             {{ desk_1500x }} 1500w,
             {{ desk_1780x }} 1780w,
      {{ desk_2000x }} 2000w"
width="1400" height="650"
      alt="" class="cocktail__img cocktail--desktop lazyload" >
  </div>
  <div class="cocktail__content">
    {% liquid 
      assign cocktail = 'cocktail.png' 
      assign text_100x = cocktail | file_img_url: '100x'
      assign text_200x = cocktail | file_img_url: '200x'
      assign text_300x = cocktail | file_img_url: '300x'
      assign text_400x = cocktail | file_img_url: '400x'
      assign text_750x = cocktail | file_img_url: '750x' %}

    <img src="{{ cocktail | file_img_url: '700x' }}"
      loading="lazy"
  aspectratio="0.6" 
      sizes="auto" 
srcset="{{ text_100x }} 100w,
             {{ text_200x }} 200w,
             {{ text_300x }} 300w,
             {{ text_400x }} 400w,
             {{ text_750x }} 750w"
width="700" height="300"
      alt="" class="cocktail--text" >
   {%- if section.settings.link != blank and section.settings.link_text != blank -%}
        <a href ="{{ section.settings.link }}" class="cocktail__link"
        style="background-image: url('//cdn.shopify.com/s/files/1/0729/2649/5002/files/white-space.svg')">{{ section.settings.link_text }}</a>
    {%- endif -%}
</div>
</div>
</section>
<script>
  document.addEventListener( 'DOMContentLoaded', function () {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {

        if (entry.isIntersecting) {
          entry.target.classList.add('animation-{{section.settings.section_animation}}');
          return; // if we added the class, exit the function
         }
      });
    });
    observer.observe(document.querySelector('.cocktail__container'));
  });
</script>
{% schema %}
{
  "name": "Cocktail",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "section_animation",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.options__1.label"
        },
        {
          "value": "fade-in",
          "label": "t:sections.all.animation.options__2.label"
        },
        {
          "value": "top",
          "label": "t:sections.all.animation.options__3.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.all.animation.options__4.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.animation.options__5.label"
        },
        {
          "value": "left",
          "label": "t:sections.all.animation.options__6.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.section_animation"
    }
  ],
  "presets": [
    {
      "name": "Cocktail"
    }
  ]
}
{% endschema %}
