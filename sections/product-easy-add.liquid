{{ 'section-easy-add.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .easy-add-section {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .easy-add-section {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
</style>

{%- if section.blocks.size > 0 -%}
  <div class="easy-add-section page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="easy-add-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <slider-component class="easy-add-carousel">
      <ul id="Slider-{{ section.id }}" class="easy-add-carousel__track" role="list">
        {%- for block in section.blocks -%}
          {%- assign easy-product = block.settings.product -%}

          {%- if easy-product != blank -%}
            <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="easy-add-carousel__slide" {{ block.shopify_attributes }}>
              <div class="easy-add-item">
                <!-- Product Image -->
                <div class="easy-add-item__image">
                  <a href="{{ easy-product.url }}">
                    {{ easy-product.featured_image | image_url: width: 300 | image_tag:
                       alt: easy-product.featured_image.alt,
                       loading: 'lazy',
                       widths: '150, 200, 250, 300'
                    }}
                  </a>
                </div>

                <!-- Product Info -->
                <div class="easy-add-item__info">
                  <!-- Product Title -->
                  <h3 class="easy-add-item__title">
                    <a href="{{ easy-product.url }}">{{ easy-product.title }}</a>
                  </h3>

                  <!-- Price -->
                  <div class="easy-add-item__price">
                    {%- render 'price', product: easy-product, use_variant: true, show_badges: false -%}
                  </div>

                  <!-- Add to Cart Button -->
                  <product-form class="easy-add-item__form">
                    {%- form 'product', easy-product, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ easy-product.selected_or_first_available_variant.id }}">

                      <button
                        type="submit"
                        name="add"
                        class="easy-add-item__button button"
                        {% if easy-product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                      >
                        <span>
                          {%- if easy-product.selected_or_first_available_variant.available -%}
                            {{ section.settings.button_text | default: 'IN DEN WARENKORB' }}
                          {%- else -%}
                            {{ 'products.product.sold_out' | t }}
                          {%- endif -%}
                        </span>
                      </button>
                    {%- endform -%}
                  </product-form>
                </div>

                <!-- Arrow Link (Desktop) -->
                <div class="easy-add-item__arrow">
                  <a href="{{ easy-product.url }}" class="easy-add-item__arrow-link">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > 1 -%}
        <div class="easy-add-carousel__controls">
          <button type="button" class="easy-add-carousel__button easy-add-carousel__button--prev" name="previous" aria-label="Previous slide">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="easy-add-carousel__button easy-add-carousel__button--next" name="next" aria-label="Next slide">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
{%- endif -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Easy Add Product",
  "tag": "section",
  "class": "section-easy-add",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "GEEIGNETES ZUBEHÖR"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "IN DEN WARENKORB"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Easy Add Product",
      "blocks": [
        {
          "type": "product"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
