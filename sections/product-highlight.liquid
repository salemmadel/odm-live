{%- if section.settings.is_above_the_fold -%}
  {{ 'component-product-highlight.css' | asset_url | stylesheet_tag }}
{%- else -%}
  <link rel="stylesheet" href="{{ 'component-product-highlight.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}


{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
#shopify-section-{{ section.id }} {
background-color: {{ section.settings.background_color }};
}

#shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} h2  {
color: {{ section.settings.text_color }};
}
{%- endstyle -%}


{%- assign product = section.settings.highlighted_product -%}
{%- if product != blank-%}

<div class="recommendation recommendation--{% if section.settings.color_scheme %} color-{{ section.settings.color_scheme }} gradient{% endif %} section-{{ section.id }}-padding page-width">

    <div class="recommendation__grid ">

        <div class="recommendation__header--desktop">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '550, 720, 990, 1100, 1500, 2200', alt: section.settings.image.alt, loading: 'lazy', draggable: 'false', class: 'recommendation__header--desktop-image' }} 
          {%- endif -%}        
        </div>

        <div class="recommendation__main">
            <div class="recommendation__header--mobile">
              {%- if section.settings.image != blank -%}
                {{ section.settings.image | image_url: width: 250 | image_tag: widths: '150, 250', alt: section.settings.image.alt, loading: 'lazy', draggable: 'false', class: 'recommendation__header--mobile-image' }} 
              {%- endif -%} 
            </div>
          {%- if section.settings.product_image != blank -%}
            {{ section.settings.product_image | image_url: width: 3840, format: 'pjpg' | image_tag: widths: ' 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: section.settings.product_image.alt, loading: 'lazy', class: 'recommendation__image' }} 
          {%- else -%}
          {{ product.featured_image.src | image_url: width: 3840, format: 'pjpg' | image_tag: widths: ' 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: product.featured_image.alt, loading: 'lazy', class: 'recommendation__image' }} 
          {%- endif -%}
        </div>

        <div class="recommendation__product--content">
          <p class="recommendation__product--description">
            {%- if section.settings.product_description != blank -%}
            {{ section.settings.product_description }}
            {%- else -%}
            {%- assign description = product.description | strip_html | truncatewords: 20 -%}
            {{ description }}
            {%- endif -%}
          </p>
          <div class="recommendation__price"><span class="recommendation__price--original">{{ product.first_available_variant.compare_at_price | money }}</span> <span class="recommendation__price--new">{{ product.first_available_variant.price | money }}</span></div>
          <div class="recommendation__button-container">
            <a href ="{{ product.url }}" class="recommendation__button-item"
          style="background-image: url('{{ 'black-bar.png' | file_img_url: '320x' }}')">{{ 'general.accessibility.discover_here' | t }}</a>
          </div>
        </div>
    </div>
</div>

{%- endif -%}
{% schema %}
{
  "name": "Product Highlight",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "is_above_the_fold",
      "label": "is Above the Fold",
      "default": false,
      "info": "Check if Content is loaded first to eliminate CLS"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.product-highlight.settings.header.label",
      "info": "t:sections.product-highlight.settings.header.info"
    },
    {
      "type": "product",
      "id": "highlighted_product",
      "label": "t:sections.product-highlight.settings.product.label"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "t:sections.product-highlight.settings.product_image.label"    },
    {
      "type": "text",
      "id": "product_description",
      "label": "t:sections.product-highlight.settings.product_description.label"
    },
    {
     "type": "color",
     "id": "background_color",
     "label": "t:sections.product-highlight.settings.background_color.label",
     "default": "#fff"
   },
   {
     "type": "color",
     "id": "text_color",
     "label": "t:sections.product-highlight.settings.text_color.label",
     "default": "#000"
   },
    {
     "type": "select",
     "id": "color_scheme",
     "options": [
       {
         "value": "accent-1",
         "label": "t:sections.all.colors.accent_1.label"
       },
       {
         "value": "accent-2",
         "label": "t:sections.all.colors.accent_2.label"
       },
       {
         "value": "background-1",
         "label": "t:sections.all.colors.background_1.label"
       },
       {
         "value": "background-2",
         "label": "t:sections.all.colors.background_2.label"
       },
       {
         "value": "inverse",
         "label": "t:sections.all.colors.inverse.label"
       },
       {
         "value": "transparent",
         "label": "transparent"
       }
     ],
     "default": "transparent",
     "label": "t:sections.all.colors.label"
   },
    {
     "type": "header",
     "content": "t:sections.all.padding.section_padding_heading"
   },
   {
     "type": "range",
     "id": "padding_top",
     "min": 0,
     "max": 100,
     "step": 4,
     "unit": "px",
     "label": "t:sections.all.padding.padding_top",
     "default": 36
   },
   {
     "type": "range",
     "id": "padding_bottom",
     "min": 0,
     "max": 100,
     "step": 4,
     "unit": "px",
     "label": "t:sections.all.padding.padding_bottom",
     "default": 36
   }
    
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:sections.product-highlight.presets.name",
      "category": "t:sections.product-highlight.presets.category"
    }
  ]
}
{% endschema %}