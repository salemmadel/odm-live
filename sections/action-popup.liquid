<link rel="stylesheet" href="{{ 'component-newsletter.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-action-shortcut.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-action-popup.css' | asset_url }}" media="print" onload="this.media='all'">


<noscript>{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-action-shortcut.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-action-popup.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
#shopify-section-{{ section.id }} .action-shortcut {
    background-color: {{ section.settings.background_color }};
}
#shopify-section-{{ section.id }} .action-shortcut p, .action-shortcut__close{
    color: {{ section.settings.text_color_mobile }};

}

#shopify-section-{{ section.id }} .action-popup  {
  background-color: {{ section.settings.background_color }};
}

#shopify-section-{{ section.id }} .action-popup__media{
  background-color: {{ section.settings.background_color_img }};

}
@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .action-popup__content{
    background-color: {{ section.settings.background_color_img }};
  }
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h1 span:first-child,  #shopify-section-{{ section.id }} a, #shopify-section-{{ section.id }} .action__close  {
  color: {{ section.settings.text_color_mobile }};
  text-shadow: none !important;
}
}
@media screen and (min-width: 750px) {
  #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} h2,  #shopify-section-{{ section.id }} .action__close {
      color: {{ section.settings.text_color }};
  }
}  
#shopify-section-{{ section.id }} .image_caption {
  padding-left: 4rem;
  margin-top: 1rem;
}

@media screen and (min-width: 750px) {
  #shopify-section-{{ section.id }} .image_caption {
    padding-left: 0rem;
  }
}


{%- if section.settings.image_caption != blank -%}
#shopify-section-{{ section.id }} .action-popup {
  padding-bottom: 7rem;
}
{%- endif -%}

{%- endstyle -%}


<div data-newsletter-popup="{{ section.settings.enable_popup }}">
</div>
  
<div id="newsletter-shortcut"></div>

<script defer="defer">
  // container for popup
  const container = document.querySelector('[data-newsletter-popup]')
  const popup = `{% render 'action-popup-template', id: section.id, content_layout: section.settings.content_layout, color_scheme: section.settings.color_scheme, desktop_image_width: section.settings.desktop_image_width, layout: section.settings.layout, desktop_content_position: section.settings.desktop_content_position, desktop_content_alignment: section.settings.desktop_content_alignment, tablet_content_alignment: section.settings.tablet_content_alignment, mobile_content_alignment: section.settings.mobile_content_alignment, height: section.settings.height, image: section.settings.image, image_tablet: section.settings.image_tablet, subheading: block.settings.subheading, heading: block.settings.heading, blocks: section.blocks %}`
  container.style.display ="none"
  // container for shortcut
  const container_shortcut = document.querySelector('#newsletter-shortcut')
  const shortcut = `{% render 'action-shortcut', id: section.id, newsletter_shortcut: section.settings.newsletter_shortcut, image_background: section.settings.image_bg_desktop %}`


  // check if user doesn't want to see the popup anymore
  const show = localStorage.getItem('newsletter_show');

  localStorage.setItem('newsletter_show', true); // Hide the newsletter-popup and shortcut

  // if popup is enabled abd user didn't hide popup 
  if(container.dataset.newsletterPopup == "true" && show != 'false') {
    container_shortcut.innerHTML = shortcut;
    container.innerHTML = popup;
    container.style.display ="none"

    // close popup and display shortcut
    //switchTabs('#newsletter-close', '.nl__popup', '.nl__shortcut')
    const switchPopup = document.querySelector('#action-popup-close')
    switchPopup.addEventListener('click', event => {
      fadeOutBottom('.action-popup')
      fadeInLeft('.nl__shortcut')
      // delete popup element after fade out animation
      setTimeout(function (){
        container.style.display ="none"
        $('.nl__shortcut').removeClass('inactive')
      }, 500); 
    })

    // display popup window when shortcut clicked
   // switchTabs('.newsletter-note__message', '.nl__shortcut', '.nl__popup')
    const switchShortcut= document.querySelector('.action-shortcut__message')
    switchShortcut.addEventListener('click', event => {
      fadeOutLeft('.nl__shortcut');
      fadeInBottom('.action-popup');
      // delete popup element after fade out animation
      setTimeout(function (){
        $('.nl__shortcut').addClass('inactive')
        container.style.display ="block"
      }, 500); 
    })


    //close shortcut 
    const closeShortcut = document.querySelector('.action-shortcut__close')
        closeShortcut.addEventListener('click', event => {
          fadeOutLeft('.nl__shortcut');
          localStorage.setItem('newsletter_show', false); // Hide the newsletter-popup and shortcut
          // delete popup element after fade out animation
          setTimeout(function (){
            $('.nl__shortcut').addClass('inactive')
          }, 500); 
        })
  }

  

  function fadeOutLeft(element){
    $(element).animate({
      opacity: 0, 
      left: '-80px'
    }, 600, 'linear');
  }

  function fadeInLeft(element){
    $(element).animate({
      opacity: 1, 
      left: 0
    }, 600, 'linear');
  }

  function fadeOutBottom(element){
    $(element).animate({
      opacity: 0, 
      top: '200px'
    }, 500, 'linear');
  }
  function fadeInBottom(element){
    if($(window).width() < 750)
      {
         // change functionality for smaller screens
         $(element).animate({
          opacity: 1, 
          top: '40px'
        }, 600, 'linear');
      } else {
         // change functionality for larger screens
         $(element).animate({
          opacity: 1, 
          top: '0px'
        }, 600, 'linear');
      }
  }

  {% comment %}

  function fade(element) {
    var op = 1;  // initial opacity
    var timer = setInterval(function () {
        if (op <= 0.1){
            clearInterval(timer);
        }
        element.style.opacity = op;
        element.style.filter = 'alpha(opacity=' + op * 100 + ")";
        op -= op * 0.2;
    }, 50);
  }

  function unfade(element) {
    var op = 0.1;  // initial opacity
    var timer = setInterval(function () {
        if (op >= 1){
            clearInterval(timer);
        }
        element.style.opacity = op;
        element.style.filter = 'alpha(opacity=' + op * 100 + ")";
        op += op * 0.2;
    }, 10);
}
 function switchTabs(currClass ,activeTab, inactiveTab){
    const close = document.querySelector(currClass)
        close.addEventListener('click', event => {
          fade(document.querySelector(activeTab))
          unfade(document.querySelector(inactiveTab))
          // delete popup element after fade out animation
          setTimeout(function (){
            $(activeTab).addClass('inactive')
            $(inactiveTab).removeClass('inactive')
          }, 500); 
        })
  }

{% endcomment %}
</script>

