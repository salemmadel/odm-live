{%- if section.settings.is_above_the_fold -%}
    {{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
    {{ 'multicolumn-video-section.css' | asset_url | stylesheet_tag }}
    {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {%- else -%}
    <link rel="stylesheet" href="{{ 'section-multicolumn.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'multicolumn-video-section.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}

  <link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

     .multicolumn-list__item-video{
      padding-left: 0px !important;
    }

    .grid__item:first-of-type {
  margin-left: 1.2rem;
}
.mutlicolumn--video .slider-dots {
  display: none !important;
}
@media screen and (min-width: 990px) {
  .grid--3-col-desktop .grid__item {
    max-width: calc(32.33% - var(--grid-desktop-horizontal-spacing) * 2 / 3);
  }
  .multicolumn-video-section {
    padding-left: 0px;
    padding-right: 0px;
    max-width: 128rem;
  }
}

    .multi-video-title h3{
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }
  
    /* CSS to ensure the play button overlay is initially hidden on mobile */
    @media screen and (max-width: 749px) {
      .play-button.hidden {
        display: none !important;
      }
    }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .section-{{ section.id }}-margin {
      margin-right: {{ section.settings.outer_padding }}rem;
      margin-left: {{ section.settings.outer_padding }}rem;
    }
  }
  {%- if section.blocks.size == 1 -%}
    @media screen and (min-width: 750px) {
      .section-{{ section.id }} .multicolumn-card {
        display: flex;
      }
      .multicolumn-card__info {
        display: flex;
        align-items: center;
      }
      .mutlicolumn--video .video-wrapper {
        width: 100%;
        display: flex;
      }
    }
  {%- endif -%}

  /* --- START: UPDATED CSS TO DISABLE MOBILE SLIDER/SCROLL --- */
  @media screen and (max-width: 749px) {
    .multicolumn-list.slider {
        /* These properties override any default horizontal scrolling */
        overflow-x: hidden !important;
        scroll-snap-type: none !important;
        
        /* KEY: Prevents the browser from initiating horizontal swipe/drag gestures */
        touch-action: pan-y !important;
        
        /* Prevents text selection drag from starting a slide */
        user-select: none !important;
    }

    /* Ensure slide items themselves also respect touch-action */
    .multicolumn-list__item {
        touch-action: pan-y !important;
    }
  }
  /* --- END: UPDATED CSS TO DISABLE MOBILE SLIDER/SCROLL --- */
  
  /* Mobile progress dots */
  .slider-dots {
    display: none;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
    padding: 0;
  }

  @media screen and (max-width: 749px) {
    .slider-dots--visible {
      display: flex;
    }
       .multicolumn-list__item{
        width: calc(100% - var(--grid-mobile-horizontal-spacing) - 2rem) !important;
   }
  }

  .slider-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
    border: 1px solid black;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .slider-dot--active {
    background: black;
    border: 1px solid black;
  }
{%- endstyle -%}

{%- liquid
    assign columns_mobile_int = section.settings.columns_mobile | plus: 0
    assign show_mobile_slider = false
    if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
      assign show_mobile_slider = true
    endif
-%}

<div class="multicolumn mutlicolumn--video section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.title == blank %} no-heading{% endif %}">
  <div class="page-width multicolumn-video-section section-{{ section.id }}-padding isolate">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title {{ section.settings.heading_size }}">
          {{ section.settings.title | escape }}
        </h2>
        <div class="title-wrapper__text">{{ section.settings.title_text }}</div>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link" style="display: none;">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <infinite-slider-component class="slider-mobile-gutter section-{{ section.id }}-margin">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--mobile grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- assign empty_column = '' -%}
          {%- if block.settings.video_url == blank and block.settings.title == blank and block.settings.text == blank and block.settings.link_label == blank -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}
<li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item multicolumn-list__item-video js-slide-content-wrapper grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}"
            {{ block.shopify_attributes }}
          >
            <div class="multicolumn-card content-container {% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} color-{{ section.settings.background_style }}{% endunless %}">
              {% if block.settings.video_url %}
                <div class="multicolumn-card__video video-wrapper">
                  <div class="deferred-media__poster-button motion-reduce play-button">
                    {% render 'icon-play' %}
                  </div>
                  
                  {%- assign video_poster_url = '' -%}
                  {%- if block.settings.thumbnail_image != blank -%}
                    {%- comment -%} Use the selected image for the poster attribute {%- endcomment -%}
                    {%- assign video_poster_url = block.settings.thumbnail_image | image_url: width: 1000 -%}
                  {%- endif -%}

                  <video
                    playsinline
                    loop
                    muted     {# Muted is necessary for policy compliance on mobile, but is always safe to include #}
                    class="video-column"
                    {% if video_poster_url != blank %}
                      poster="{{ video_poster_url }}"
                    {% endif %}
                  >
                    <source src="{{ block.settings.video_url }}" type="video/mp4">
                  </video>
                  
                  {%- if block.settings.title != blank and block.settings.overlay_title -%}
                    <div class="media-overlay__title media_overlay_title--{{ block.settings.overlay_title_position }}">
                      <h3>{{ block.settings.title | escape }}</h3>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="multicolumn-card__info">
                <div class="multi-video-title multicolumn-card__info-content">
                  {%- if block.settings.title != blank and block.settings.overlay_title == false -%}
                    <h3>{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="rte{% if block.settings.mobile_text != blank %} hidden-sm{% endif %}">{{ block.settings.text }}</div>
                    <div class="rte{% if block.settings.mobile_text != blank %} hidden-lg{% endif %}">{{ block.settings.mobile_text }}</div>
                  {%- endif -%}
                  {%- if block.settings.link_label != blank -%}
                    {%- if block.settings.selected_button != true -%}
                      <a
                        class="link animate-arrow multicolumn__button--{{ block.settings.button_alignment }}"
                        {% if block.settings.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.link }}"{% endif %}
                      >
                        {{ block.settings.link_label | escape }}<span class="icon-wrap">&nbsp;{% render 'icon-arrow' %}</span>
                      </a>
                    {%- else -%}
                      <a
                        class="button multicolumn__button--{{ block.settings.button_alignment }}"
                        {% if block.settings.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.link }}"{% endif %}
                      >
                        {{ block.settings.link_label | escape }}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons no-js-hidden medium-hide">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">{% render 'icon-caret' %}</button>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">{% render 'icon-caret' %}</button>
        </div>

        {%- comment -%} Mobile progress dots — only visible on mobile when slider is active {%- endcomment -%}
        <div class="slider-dots slider-dots--visible" role="tablist" aria-label="{{ 'general.slider.slide_progress' | t }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="slider-dot{% if forloop.first %} slider-dot--active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="{{ 'general.slider.go_to_slide' | t: number: forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </infinite-slider-component>

    <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--primary"
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const videos = document.querySelectorAll('video');
    const playButtons = document.querySelectorAll('.play-button');
    const slider = document.getElementById('Slider-{{ section.id }}');
    const dots = document.querySelectorAll('.slider-dot');
    const sliderItems = document.querySelectorAll('#Slider-{{ section.id }} .multicolumn-list__item'); // Target the slide items
    
    // Define the desktop breakpoint used in your CSS (750px)
    const DESKTOP_BREAKPOINT = 750;

    // Function to check if the current view is considered desktop
    const isDesktop = () => window.innerWidth >= DESKTOP_BREAKPOINT;
    
    // Function to handle video state changes (play/pause)
    const toggleVideo = (video, button) => {
      if (video.paused) {
        video.play();
        // Hide the play button when video is playing
        if (button) {
          button.classList.add('hidden');
        }
      } else {
        video.pause();
        // Show the play button when video is paused
        if (button) {
          button.classList.remove('hidden');
        }
      }
    };
    
    // --- START: NEW/UPDATED LOGIC TO DISABLE SLIDE/SCROLL ON MOBILE ---
    if (!isDesktop()) {
        sliderItems.forEach(item => {
            // 1. Prevent click/tap on the slide item itself from initiating a slide
            item.addEventListener('click', function(event) {
                // If the click is not on the arrow buttons or video play buttons, stop propagation
                if (!event.target.closest('.slider-button, .play-button, .slider-dot, a, button')) {
                    event.preventDefault(); 
                    event.stopPropagation();
                }
            });

            // 2. Aggressively disable touch/swipe drag that causes the movement
            // This is essential to prevent sliding when user scrolls left/right on the slide
            item.addEventListener('touchstart', (event) => {
                event.stopPropagation();
            }, { passive: true }); // Keep passive: true as touch-action CSS handles the block

            item.addEventListener('touchmove', (event) => {
                // event.preventDefault(); // This is handled by CSS touch-action: pan-y, uncomment if needed
                event.stopPropagation(); 
            }, { passive: true });
        });
    }
    // --- END: NEW/UPDATED LOGIC TO DISABLE SLIDE/SCROLL ON MOBILE ---


    videos.forEach((v, i) => {
      const btn = playButtons[i];

      if (!isDesktop()) {
        // 🚀 MOBILE / TABLET AUTOPLAY LOGIC 🚀
        // Video is always muted for policy compliance.
        v.muted = true;
        
        // Attempt to play immediately
        v.play().then(() => {
          // Success: Hide the play button overlay
          if (btn) {
            btn.classList.add('hidden');
          }
        }).catch(error => {
          // Failure (e.g., policy blocks it): Keep the play button visible
          if (btn) {
            btn.classList.remove('hidden');
          }
          // console.warn('Mobile Autoplay failed for a video:', error);
        });

        // Mobile: Clicking the video itself should toggle play/pause
        v.addEventListener('click', (event) => {
          event.stopPropagation();
          toggleVideo(v, btn);
        });

        // Mobile: Clicking the button also toggles (in case autoplay failed)
        if (btn) {
          btn.addEventListener('click', (event) => {
            event.stopPropagation();
            toggleVideo(v, btn);
          });
        }
        
      } else {
        // 💻 DESKTOP CLICK-TO-PLAY LOGIC 💻
        
        // 1. Desktop: Ensure video is paused by default and play button is visible
        v.pause();
        if (btn) {
          btn.classList.remove('hidden'); // Ensure play button is visible
        }

        // 2. Desktop: Clicking the play button starts playback
        if (btn) {
          btn.addEventListener('click', (event) => {
            event.stopPropagation();
            // Mute is always set (good practice)
            v.muted = true;
            toggleVideo(v, btn);
          });
        }
        
        // 3. Desktop: Clicking the video itself should pause/play *after* the initial click
        v.addEventListener('click', (event) => {
          event.stopPropagation();
          // Only toggle if the video is already playing or paused by user interaction
          if (v.currentTime > 0 || !v.paused) {
              toggleVideo(v, btn);
          }
        });
      }
    });

    // --- SLIDER DOTS LOGIC (Retained) ---
    if (slider && dots.length > 0) {
      // Click to navigate
      dots.forEach((dot, index) => {
        dot.addEventListener('click', (event) => {
          event.stopPropagation();
          
          const total = dots.length;
          // Calculate the scroll position for the target slide
          const slideWidth = slider.scrollWidth / total;
          
          slider.scrollTo({
            left: slideWidth * index,
            behavior: 'smooth'
          });

          // Manually update dot state
          dots.forEach((d, i) => {
            d.classList.toggle('slider-dot--active', i === index);
            d.setAttribute('aria-selected', i === index ? 'true' : 'false');
          });
        });
      });
      
      // Initialize the first dot as active on load
      if (dots[0]) {
        dots[0].classList.add('slider-dot--active');
        dots[0].setAttribute('aria-selected', 'true');
      }
    }
  });
</script>

{% schema %}
{
  "name": "Multicolumn Video Section",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "is_above_the_fold",
      "label": "is Above the Fold",
      "default": false,
      "info": "Check if Content is loaded first to eliminate CLS"
