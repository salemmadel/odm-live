<link rel="stylesheet" href="{{ 'gang.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'gang.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding gang__products page-width">
  <span class="h2 h2--with-circle" style="background-image: url('{{ 'circle.png' | file_img_url: '700x' }}')">{{ 'gang.rules.collect' | t }}</span>
  <div data-lion-rules-list class="tw-prose"></div>
  {% if section.settings.reviews  %}
    <p>{{ 'gang.tiers.reviews' | t }}</p>
  {% endif  %}
</section>

{% schema %}
{
  "name": "Gang Rules",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "checkbox",
      "id": "reviews",
      "default": true,
      "label": "Reviews?"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Gang Rules"
    }
  ]
}
{% endschema %}
