{% style %}
  .custom-header-section-{{ section.id }} {
    /* Dynamic Background Color: Pulled from the section settings */
    background-color: {{ section.settings.background_color }};
    
    /* Dynamic Text Color: Pulled from the section settings */
    /* This color is now primarily for the section's general text, like the subtitle and separator line. */
    color: {{ section.settings.text_color }}; 
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    
    width: 100%;
    overflow: hidden; /* Prevent horizontal scroll issues */
  }



  .custom-header-section-{{ section.id }} .section-title {
    font-size: 27px; 
    font-weight: bold;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0px !important;
    /* NEW: Dynamic color for the headline text */
    color: {{ section.settings.headline_color }}; 
  }

  .custom-header-section-{{ section.id }} .section-subtitle {
    font-size: 17px; 
    font-weight: 400;
    opacity: 0.8;
    margin: 0px !important;
    /* NEW: Dynamic color for the border-bottom */
    border-bottom: 1px solid {{ section.settings.border_bottom_color }};
  }

  .custom-header-section-{{ section.id }} .separator-line {
    width: 100%;
    height: 1px;
    /* Separator line color matches the general text color */
    background-color: {{ section.settings.text_color }}; 
    opacity: 0.4;
  }

@media (max-width: 768px) {
    .custom-header-section{
        padding-top: 2rem !important;
    }
    .custom-header-section-{{ section.id }} .section-title {
        font-size: 24px;
    }
    .custom-header-section-{{ section.id }} .section-subtitle {
        font-size: 16px;
    }

    .section-title{
        font-size: 18px !important;
    }
    .section-subtitle{
        font-size: 14px !important;
    }
  }

  .custom-header-section .content-container {
    max-width: 100vw !important;
    padding-left: 5%;
  }

@media screen and (max-width: 759px) {
  .section-title,
  .section-subtitle {
    padding-left: 0px; 
  }
}


{% endstyle %}


<div class="custom-header-section-{{ section.id }} custom-header-section">
    <div class="content-container">
        
        {% if section.settings.title != blank %}
          <h2 class="section-title">
              {{ section.settings.title | escape }}
          </h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="section-subtitle">
              {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
        
        <div class="separator-line"></div>
    </div>
</div>


{% schema %}
{
  "name": "Rich Text Header",
  "tag": "section",
  "class": "section-rich-text-header",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "CHRISTMAS THEMED GIFTS."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Our Christmas Packed Gifts."
    },
    {
      "type": "header",
      "content": "Colors and Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "info": "This setting allows you to change the color dynamically."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "General Text Color (Sub-Text & Separator)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_bottom_color",
      "label": "Subheading Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Rich Text Header",
      "category": "Text"
    }
  ]
}
{% endschema %}