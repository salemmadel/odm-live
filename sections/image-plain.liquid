{%- if section.settings.is_above_the_fold -%}
  {{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{%- else -%}
  <link rel="stylesheet" href="{{ 'component-image-with-text.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}


{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .desktop_img {
    height: auto;
    margin: auto;
    width: {{ section.settings.desktop_image_width }}%;
  }

  .mobile_img {
    height: auto;
    margin: auto;
    width: {{ section.settings.mobile_image_width }}%;
  }
{%- endstyle -%}

<div class="{% unless section.settings.full_width_enabled %} page-width {% endunless %} isolate section-{{ section.id }}-padding">
    {%- if section.settings.image != blank and section.settings.image_mobile != blank -%}
      {{ section.settings.image_mobile | image_url: width: 3840 | image_tag: widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: section.settings.image_mobile.alt, loading: 'lazy', class: 'hidden-lg mobile_img'}}

      {{ section.settings.image | image_url: width: 3840 | image_tag: widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: section.settings.image.alt, loading: 'lazy', class: 'hidden-sm desktop_img'}}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3840 | image_tag: widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: section.settings.image.alt, loading: 'lazy', class: 'desktop_img' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.plain",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "is_above_the_fold",
      "label": "is Above the Fold",
      "default": false,
      "info": "Check if Content is loaded first to eliminate CLS"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.image-with-text.settings.image.mobile"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.image-with-text.settings.image.desktop_w",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_image_width",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.image-with-text.settings.image.mobile_w",
      "default": 100
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "full_width_enabled",
      "label": "Full width",
      "default": false,
      "info": "Check if image should take the whole width of the page"
    }
  ],
   "presets": [
    {
      "name": "t:sections.image-with-text.plain"
    }
  ]
}
{% endschema %}
