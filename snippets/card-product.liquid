<link rel="stylesheet" href="{{ 'component-rating.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-season-badge.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-inventory.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign product_media = card_product.featured_media 
    if custom_featured_media != blank
      assign product_media = custom_featured_media
      assign is_custom_media_used = true
    else
      assign is_custom_media_used = false
    endif

    assign ratio = 1
    if product_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif product_media and media_aspect_ratio == 'adapt'
      assign ratio = product_media.aspect_ratio
    endif
    if ratio == 0 or ratio == nil
      assign ratio = 1
    endif

    assign product_badges = card_product.metafields.m_p.badges.value
  
    for badge in product_badges
      
      assign image_desktop = badge.image_desktop.value
      assign image_mobile = badge.image_mobile.value
      assign position = badge.position.value | handleize

      case position
        when "top-left"
          assign position = "top-0 start-0 mt-1 ms-1"
        when "top-right"
          assign position = "top-0 end-0 mt-1 me-1"
        when "bottom-left"
          assign position = "bottom-0 start-0 mb-1 ms-1"
        when "bottom-right"
          assign position = "bottom-0 end-0 mb-1 me-1"
        else
          assign position = "top-0 start-0 mt-1 ms-1"
      endcase

      if image_desktop != empty
        capture badge_image
          render "image", image: image_mobile, image_md: image_desktop, is_lazy: true, width: "75px", width_md: "85px"
        endcapture
      endif
    endfor
  -%}

  <div class="card-wrapper underline-links-hover">
    <div class="card
      card--{{ settings.card_style }}
      {% if product_media %} card--media{% else %} card--text{% endif %}
      {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
      {% if product_media == nil and settings.card_style == 'card' %} ratio{% endif %}
       card_product"
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      <div class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if product_media or settings.card_style == 'standard' %} ratio{% endif %}" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
        {%- if product_media -%}
          <div class="card__media{% if card_product.available == false and grey_sold_out_products == true %} card__media-soldout{% endif %}">
              
            <div class="media media--transparent media--hover-effect">
              
              
              <img
            src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-srcset="{%- if product_media.width >= 145 -%}{{ product_media | image_url: width: 145, format: 'jpg' }} 145w,{%- endif -%}
          {%- if product_media.width >= 165 -%}{{ product_media | image_url: width: 165, format: 'jpg' }} 165w,{%- endif -%}
                  {%- if product_media.width >= 360 -%}{{ product_media | image_url: width: 360, format: 'jpg' }} 360w,{%- endif -%}
                  {%- if product_media.width >= 533 -%}{{ product_media | image_url: width: 533, format: 'jpg' }} 533w,{%- endif -%}
                  {%- if product_media.width >= 720 -%}{{ product_media | image_url: width: 720, format: 'jpg' }} 720w,{%- endif -%}
                  {%- if product_media.width >= 940 -%}{{ product_media | image_url: width: 940, format: 'jpg' }} 940w,{%- endif -%}
                  {%- if product_media.width >= 1066 -%}{{ product_media | image_url: width: 1066, format: 'jpg' }} 1066w,{%- endif -%}
                  {{ product_media | image_url }} {{ product_media.width }}w"
                data-src="{{ product_media | image_url: width: 533, format: 'jpg' }}"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                alt="{{ product_media.alt | escape }}"
                class="motion-reduce lazyload"
                {% unless lazy_load == false %}loading="lazy"{% endunless %}
                width="533"
                height="533"
              >
              

              {%- if card_product.media[1] != nil and show_secondary_image and custom_featured_media == blank -%}
                <img
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-srcset="{%- if card_product.media[1].width >= 145 -%}{{ card_product.media[1] | image_url: width: 145, format: 'jpg' }} 145w,{%- endif -%}
                {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165, format: 'jpg' }} 165w,{%- endif -%}
                    {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360, format: 'jpg' }} 360w,{%- endif -%}
                    {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533, format: 'jpg' }} 533w,{%- endif -%}
                    {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720, format: 'jpg' }} 720w,{%- endif -%}
                    {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940, format: 'jpg' }} 940w,{%- endif -%}
                    {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066, format: 'jpg' }} 1066w,{%- endif -%}
                    {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w"
                  data-src="{{ card_product.media[1] | image_url: width: 533, format: 'jpg' }}"
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  alt="{{ card_product.media[1].alt | escape }}"
                  class="motion-reduce lazyload"
                  loading="lazy"
                  width="533"
                  height="533"
                >
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        <div class="card__content">
          <div class="card__information card-information-start">
            <h3 class="card__heading"{% if product_media == nil and settings.card_style == 'standard' %} id="title-{{ section_id }}-{{ card_product.id }}"{% endif %}>
              <a href="{{ card_product.url }}" class="full-unstyled-link card-title-fixed-heigh">
                {{ card_product.title | escape }} 
              </a>
            </h3>
            <div class="yotpo bottomLine"
              data-appkey="bQDcQaEKZ14rrLm0C7WKPSJoZ1sP8Q3RirvNnd14"
              data-domain="{{shop.permanent_domain | escape }}"
              data-product-id="{{ card_product.id }}"
              data-product-models="{{ card_product.id }}"
              data-name="{{ card_product.title | escape }}"
              data-url="{{ shop.url }}{{ card_product.url }}"
              data-image-url="{{ product_media | product_img_url: 'large' |replace: '?', '%3F' | replace: '&','%26'}}"
              data-description="{{ card_product.description | escape }}"
              data-bread-crumbs="{% for tag in card_product.tags %}{{ tag | escape }};{% endfor %}">
            </div>
          </div>
          
          <div class="card__badges-container">
            {% comment %}
              START: Converted elsif/else chain into multiple if blocks to allow badges to show simultaneously.
            {% endcomment %}

            {%- if card_product.tags contains 'blackfriday' -%}
              <div class="card__badge card__season-badge {% if card_product.available == false and grey_sold_out_products == true %} card__season-badge-soldout{% endif %}">
                {% liquid 
                  assign special_img = "BlackFridayBadge.png"
                  assign bf_100x = special_img | file_img_url: '100x'
                  assign bf_200x = special_img | file_img_url: '200x'
                  assign bf_300x = special_img | file_img_url: '300x'
                  %}
                  <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ special_img | file_img_url: '200x' }}"
                    loading="lazy"
                    aspectratio="2.4" 
                    sizes="auto" 
                    data-srcset="{{ bf_100x }} 100w,
                                  {{ bf_200x }} 200w,
                                  {{ bf_300x }} 300w"
                    width="120" height="120"
                    alt="" class="season-badge--blackfriday lazyload" >
              </div>
            {%- endif -%}
            
            {%- if card_product.tags contains 'BW' -%}
              <div class="card__badge card__blackweek-badge {% if card_product.available == false and grey_sold_out_products == true %} card__season-badge-soldout{% endif %}">
                <span class="badge badge-blackweek">DEAL %</span>
              </div>
            {%- endif -%}
            
            {%- if card_product.tags contains 'bware' -%}
                  <span class="badge badge--top-left color-{{ settings.sale_badge_color_scheme }}">
                    <p style="margin: 0px">-25%</p>
           
                </span>
              <div class="card__badge card__bware-badge {% if card_product.available == false and grey_sold_out_products == true %} card__season-badge-soldout{% endif %}">
                {{ 'B-WARE_BADGE_3.png' | file_img_url: '130x' | img_tag: 'bware', '100x100', class:"product__bware-badge-image" }}
              </div>
            {%- endif -%}
            
            {%- if card_product.tags contains 'Gang' -%}
              <div class="card__badge card__gang-badge {% if card_product.available == false and grey_sold_out_products == true %} card__season-badge-soldout{% endif %}">
                {{ 'gang_badge-light.png' | file_img_url: '130x' | img_tag: 'gang', '100x100', class:"product__gang-badge-image" }}
              </div>
            {%- endif -%}
            
            {%- if  card_product.tags contains 'summer' and settings.show_summer_badges -%}
                <div class="card__badge card__season-badge {% if card_product.available == false and grey_sold_out_products == true %} card__season-badge-soldout{% endif %}">
                {{ 'summer.png' | file_img_url: '120x' | img_tag: 'summer', '200x200', class:"card__season-badge-image" }}
                </div>
            {%- endif -%}
            
            {%- if card_product.tags contains 'winter' and settings.show_winter_badges -%}
                <div class="card__badge card__season-badge {% if card_product.available == false and grey_sold_out_products == true %} card__season-badge-soldout{% endif %}">
                  {{ 'WinterEdition23.png' | file_img_url: '120x' | img_tag: 'winter', '200x200', class:"card__season-badge-image" }}
                </div>
            {%- endif -%}
            
            {% comment %}
              END: Multiple badge display logic. The next badge is the standard 'new'/'sold-out'/'on-sale' badge.
            {% endcomment %}


            <div class="card__badge {{ settings.badge_position }}">
              {% comment %} {%- if card_product.metafields.product.status_text -%}
                <div class="badge badge-status">
                  {{- card_product.metafields.product.status_text -}}
                </div> {% endcomment %}
              {%- if  card_product.tags contains 'new' -%}
                  <div class="badge badge-status">
                    {{ 'products.product.new' | t }}
                  </div>
              {%- elsif card_product.available == false -%}
                <span class="badge badge-sold-out badge--top-left color-{{ settings.sold_out_badge_color_scheme }}">{{ 'products.product.sold_out' | t }}</span>
              {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
                {%- liquid
                  assign discount = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | money_without_currency | replace: ",", "." | times: 100 | remove: '.0'
                  assign discount_text = 'products.product.percentage_off' | t
                  assign discount = discount | append: discount_text | prepend: '-'
                  assign ignore_compare_price_flashtag = false
                  if card_product.tags contains "No Compare Flashtag"
                    assign ignore_compare_price_flashtag = true
                  endif
                -%}
                {% comment %} <span class="badge badge--top-left color-{{ settings.sale_badge_color_scheme }}">
                  {%- if settings.replace_sale_badge_with_discount_percentage and ignore_compare_price_flashtag == false -%}
                    {{ discount }}
                  {%- else -%}
                    {{ 'products.product.on_sale' | t }}
                  {%- endif -%}
                </span> {% endcomment %}
              {%- endif -%}
            </div>
            
            {%- if badge_image != blank -%}
              <div class="📐">
                <div class="position-absolute {{ position }} z-index-1">
                  {{ badge_image }}
                </div>
              </div>
            {%- endif -%}
          </div>
          
          {%- if settings.enable_wishlist -%}
          <div class="wishlist-engine" data-product_id="{{  card_product.id }}" data-variant_id="{{ card_product.selected_or_first_available_variant.id }}" data-full_button="false" data-css="true"></div>
          {%- endif -%}
        </div>
      </div>
      <div class="card__content">
        <div class="card__information card-information-start">
          <h3 class="card__heading"{% if product_media or settings.card_style == 'card' %} id="title-{{ section_id }}-{{ card_product.id }}"{% endif %}>
            <a href="{{ card_product.url }}" class="full-unstyled-link card-title-fixed-heigh">
              {{ card_product.title | escape }}
            </a>
          </h3>
          <div class="yotpo bottomLine"
              data-appkey="{{ settings.yotpo_key }}"
              data-domain="{{shop.permanent_domain | escape }}"
              data-product-id="{{ card_product.id }}"
              data-product-models="{{ card_product.id }}"
              data-name="{{ card_product.title | escape }}"
              data-url="{{ shop.url }}{{ card_product.url }}"
              data-image-url="{{ product_media | product_img_url: 'large' |replace: '?', '%3F' | replace: '&','%26'}}"
              data-description="{{ card_product.description | escape }}"
              data-bread-crumbs="{% for tag in card_product.tags %}{{ tag | escape }};{% endfor %}">
            </div>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
            {%- endif -%}

            <span class="caption-large light">{{ block.settings.description | escape }}</span>

            {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
              {% liquid
                assign rating_decimal = 0
                assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
                if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
                elsif decimal > 0.7
                  assign rating_decimal = 1
                endif
              %}
              <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}">
                <span aria-hidden="true" class="rating-star color-icon-{{ settings.accent_icons }}" style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
              </div>
              <p class="rating-text caption">
                <span aria-hidden="true">{{ card_product.metafields.reviews.rating.value }} / {{ card_product.metafields.reviews.rating.value.scale_max }}</span>
              </p>
              <p class="rating-count caption">
                <span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
                <span class="visually-hidden">{{ card_product.metafields.reviews.rating_count }} {{ "accessibility.total_reviews" | t }}</span>
              </p>
            {%- endif -%}

            {% render 'price', use_variant:true, product: card_product, price_class: '', use_standard: true %}
          </div>
          <div class="card__content_inventory inventory-badge">
            {%- if card_product.metafields.custom.display_inventory >0 and card_product.selected_or_first_available_variant.available -%}
                <div class="inventory-badge__container">{% render 'blinking-dot' %} {{ 'products.product.selling_fast' | t }}</div>
              {%- endif -%}
          </div>    
        </div>
        {%- if show_quick_add -%}
          <div class="quick-add">
            {%- assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id -%}
            {%- liquid
              assign use_inline_form = false
              if card_product.variants.size == 1 or card_product.has_only_default_variant
                assign use_inline_form = true
              endif
              if card_product.metafields.custom.products_for_sets.value != blank
                assign use_inline_form = false
              endif
            -%}
            {%- if use_inline_form -%}
              <product-form>
                {%- form 'product', card_product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}" disabled>
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit button button--full-width button--secondary"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    aria-live="polite"
                    data-sold-out-message="true"
                    {% if card_product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                  >
                    <span>
                      {%- if card_product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="sold-out-message hidden">
                      {{ 'products.product.sold_out' | t }}
                    </span>
                    <div class="loading-overlay__spinner hidden">
                      <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                  </button>
                {%- endform -%}
              </product-form>
            {%- else -%}
              <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit button button--full-width button--secondary"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  data-product-url="{{ card_product.url }}"
                >
                  {{ 'products.product.choose_options' | t }}
                  <div class="loading-overlay__spinner hidden">
                    <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </button>
              </modal-opener>
              <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
                <div role="dialog" aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}" aria-modal="true" class="quick-add-modal__content global-settings-popup" tabindex="-1">
                  <button id="ModalClose-{{ card_product.id }}" type="button" class="quick-add-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
                  <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info">
                  </div>
                </div>          
              </quick-add-modal>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="card__badge {{ settings.badge_position }}">
          {%- if card_product.available == false -%}
            <span class="badge badge-sold-out badge--top-left color-{{ settings.sold_out_badge_color_scheme }}">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
            <span class="badge badge--top-left color-{{ settings.sale_badge_color_scheme }}">{{ 'products.product.on_sale' | t }}</span>
          {%- endif -%}        
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper underline-links-hover">
    <div class="card
      card--{{ settings.card_style }}
      card--text
      {% if extend_height %} card--extend-height{% endif %}
      {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
      {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}"
      style="--ratio-percent: 100%;"
    >
      <div class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if settings.card_style == 'standard' %} ratio{% endif %}" style="--ratio-percent: 100%;">
        <div class="card__content">
          <div class="card__information card-information-start">
            <h3 class="card__heading">
              <a role="link" aria-disabled="true" class="full-unstyled-link">
                {{ 'onboarding.product_title' | t }}
              </a>
            </h3>
          </div>
        </div>
      </div>
      <div class="card__content">
        <div class="card__information card-information-start">
          <h3 class="card__heading{% if settings.card_style == 'standard' %} h5{% endif %}">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.product_title' | t }}
            </a>
          </h3>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ 'products.product.vendor' | t }}</div>
            {%- endif -%}
            {% render 'price' %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}