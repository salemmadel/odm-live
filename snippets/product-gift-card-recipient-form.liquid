{%- comment -%}
  Renders gift card recipient form.

  Accepts:
  - product: {Product} product object.
  - form: {Form} the product form object.
  - section: {Section} section to which this snippet belongs.

  Usage:
  {%- render 'product-gift-card-recipient-form', product: product, form: form, section: section -%}

{%- endcomment -%}

{% comment %} {%- render "vendor-bootstrap" -%} {% endcomment %}

<div class="customer">
  {%- assign gift_card_recipient_control_flag = 'properties[__shopify_send_gift_card_to_recipient]' -%}
  <script src="{{ 'recipient-form.js' | asset_url }}" defer="defer"></script>
  <recipient-form
    class="recipient-form"
    data-section-id="{{ section.id }}"
    data-product-variant-id="{{ product.selected_or_first_available_variant.id }}"
  >
    <div class="form-check">
      <input
        id="Recipient-Checkbox-{{ section.id }}"
        type="checkbox"
        class="form-check-input recipient-form-checkbox field--checkbox"
        name="{{ gift_card_recipient_control_flag }}"
        form="{{ product_form_id }}"
        disabled
        unchecked
        data-bs-toggle="collapse"
        data-bs-target="#recipient-fields"
        aria-expanded="false"
        aria-controls="recipient-fields"
      >
      <label class="form-check-label recipient-checkbox field__label--checkbox" for="Recipient-Checkbox-{{ section.id }}">
        {{ 'recipient.form.checkbox' | t }}
      </label>
    </div>

    <div
      class="product-form__recipient-error-message-wrapper"
      role="alert"
      {% unless form.errors %}
        hidden
      {% endunless %}
    >
      <h2 class="" tabindex="-1" autofocus>
        <i class="fa-regular fa-circle-exclamation fa-bounce"></i>
        <span class="error-message">{{ 'templates.contact.form.error_heading' | t }}</span>
      </h2>

      <ul>
        {%- if form.errors -%}
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href="#Recipient-{{ field }}-{{ section.id }}">
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>

    <div id="recipient-fields" class="recipient-fields collapse" style="display: none; margin-top: 20px;">
      <div class="grid grid--1-col grid--1-col-desktop">
        <div class="grid__item ">
          <div class="recipient-fields__field">
            <div class="field">
              <input
                class="field__input"
                id="Recipient-email-{{ section.id }}"
                type="email"
                form="{{ product_form_id }}"
                placeholder="{{ 'recipient.form.email' | t }}"
                name="properties[Recipient email]"
                value="{{ form.email }}"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="RecipientForm-email-error-{{ section.id }}"
                {% endif %}
              >
              <label class="field__label" for="Recipient-email-{{ section.id }}">
                {{ 'recipient.form.email_label' | t }}
              </label>
            </div>
    
            <div
              id="RecipientForm-email-error-{{ section.id }}"
              class="{% unless form.errors contains 'email' %} d-none {% endunless %}"
            >
              <i class="fa-regular fa-circle-exclamation fa-bounce"></i>
              <span class="error-message">
                {%- if form.errors contains 'email' -%}
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}.
                {%- endif -%}
              </span>
            </div>
          </div>
        </div>
        <div class="grid__item">
          <div class="recipient-fields__field">
            <div class="field">
              <input
                class="form-control"
                autocomplete="name"
                type="text"
                id="Recipient-name-{{ section.id }}"
                form="{{ product_form_id }}"
                name="properties[Recipient name]"
                placeholder="{{ 'recipient.form.name' | t }}"
                value="{{ form.name }}"
                {% if form.errors contains 'name' %}
                  aria-invalid="true"
                  aria-describedby="RecipientForm-name-error-{{ section.id }}"
                {% endif %}
              >
              <label class="field__label form-label" for="Recipient-name-{{ section.id }}">
                {{- 'recipient.form.name_label' | t -}}
              </label>
            </div>
    
            <div
              id="RecipientForm-name-error-{{ section.id }}"
              class="{% unless form.errors contains 'name' %} d-none {% endunless %}"
            >
              <i class="fa-regular fa-circle-exclamation fa-bounce"></i>
              <span class="error-message">
                {%- if form.errors contains 'name' -%}
                  {{ form.errors.translated_fields.name | capitalize }}
                  {{ form.errors.messages.name }}.
                {%- endif -%}
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="grid grid--1-col grid--1-col-desktop">
        <div class="grid__item">
          <div class="recipient-fields__field">
            {%- assign max_chars_message = 200 -%}
            {%- assign max_chars_message_rendered = 'recipient.form.max_characters' | t: max_chars: max_chars_message -%}
            {%- assign message_label_rendered = 'recipient.form.message_label' | t -%}
            <div class="field">
              <textarea
                rows="5"
                id="Recipient-message-{{ section.id }}"
                class="text-area field__input"
                name="properties[Message]"
                form="{{ product_form_id }}"
                maxlength="{{ max_chars_message }}"
                placeholder="{{ 'recipient.form.message' | t }}"
                aria-label="{{ message_label_rendered }} {{ max_chars_message_rendered }}"
                {% if form.errors contains 'message' %}
                  aria-invalid="true"
                  aria-describedby="RecipientForm-message-error-{{ section.id }}"
                {% endif %}
              >{{ form.message }}</textarea>
              <label class="form__label field__label form-label" for="Recipient-message-{{ section.id }}">
                {{ message_label_rendered }}
              </label>
            </div>
            <div class="form-text"><span>{{ max_chars_message_rendered }}</span></div>


    
            <div
              id="RecipientForm-message-error-{{ section.id }}"
              class="{% unless form.errors contains 'message' %} d-none {% endunless %}"
            >
              <i class="fa-regular fa-circle-exclamation fa-bounce"></i>
              <span class="error-message">
                {%- if form.errors contains 'message' -%}
                  {{ form.errors.translated_fields.message | capitalize }}
                  {{ form.errors.messages.message }}.
                {%- endif -%}
              </span>
            </div>
          </div>
        </div>
        <div class="grid__item">
          <div class="recipient-fields__field">
            <div class="field">
              <input
                class="field__input text-body form-control"
                autocomplete="send_on"
                type="date"
                form="{{ product_form_id }}"
                id="Recipient-send-on-{{ section.id }}"
                name="properties[Send on]"
                placeholder="{{ 'recipient.form.send_on' | t }}"
                pattern="\d{4}-\d{2}-\d{2}"
                value="{{ form.send_on }}"
                {% if form.errors contains 'send_on' %}
                  aria-invalid="true"
                  aria-describedby="RecipientForm-send_on-error-{{ section.id }}"
                {% endif %}
              >
              <label class="field__label form-label" for="Recipient-name-{{ section.id }}">
                {{ 'recipient.form.send_on_label' | t }}
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <input
      type="hidden"
      name="{{ gift_card_recipient_control_flag }}"
      form="{{ product_form_id }}"
      value="if_present"
      id="Recipient-Control-{{ section.id }}"
    >
    <input
      type="hidden"
      name="properties[__shopify_offset]"
      form="{{ product_form_id }}"
      value=""
      id="Recipient-timezone-offset-{{ section.id }}"
      disabled
    >
  </recipient-form>
</div>

<script>
  document.getElementById('Recipient-Checkbox-{{ section.id }}').addEventListener('change', function() {
      const toggleElement = document.getElementById('recipient-fields');
      if (this.checked) {
          toggleElement.style.display = 'block';
      } else {
          toggleElement.style.display = 'none';
      }
  });
</script>
