{% comment %}
Usage:
  {% render 'moonshine-card', product_name: block.settings.product_name, is_even: is_even, product_headline: block.settings.product_headline, product_image: block.settings.product_image,  product_text: block.settings.product_text%}
{% endcomment %}
{% assign product = all_products[product_name] %}
<a href="{{ product.url }}" class="moonshine__card {% unless product.available %} moonshine__card--out {%- endunless -%} "> <!-- container for one bottle -->

  <div class="moonshine__images">
    {{  product_image | image_url: width: 1500, format: 'jpg' | image_tag: widths: '375, 550, 750, 1100, 1500', alt:  product_image.alt, loading: 'lazy', class: 'history_image moonshine__images__product' }}

      <div class="moonshine__images__season">
        {%- if product.tags contains 'blackfriday' -%}
          <div class="product__badge product__season-badge ">
          {% liquid 
            assign special_img = "BlackFridayBadge.png"
            assign bf_80x = special_img | file_img_url: '80x'
            assign bf_100x = special_img | file_img_url: '100x'
            assign bf_200x = special_img | file_img_url: '200x'
            assign bf_300x = special_img | file_img_url: '300x'
            %}
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ special_img | file_img_url: '200x' }}"
              loading="lazy"
              aspectratio="2.4" 
              sizes="auto" 
              data-srcset="{{ bf_80x }} 80w,
                            {{ bf_100x }} 100w,
                            {{ bf_200x }} 200w,
                            {{ bf_300x }} 300w"
              width="120" height="120"
              alt="" class=" season-badge--blackfriday lazyload" >
            </div>
          {%- elsif  product.tags contains 'Gang' -%}
            <div class="product__badge product__gang-badge">
              {{ 'gang_badge-light.png' | file_img_url: '130x' | img_tag: 'gang', '100x100', class:"product__gang-badge-image" }}
            </div>
          {%- else -%}
              {%- if  product.tags contains 'summer' and settings.show_summer_badges -%}
                <div class="product__badge product__season-badge ">
                {{ 'summer.png' | file_img_url: '130x' | img_tag: 'summer', '110x110', class:"product__season-badge-image" }}
                </div>
              {%- elsif product.tags contains 'winter' and settings.show_winter_badges  -%}
                <div class="product__badge product__season-badge ">
                {{ 'WinterEdition23.png' | file_img_url: '130x' | img_tag: 'winter', '110x110', class:"product__season-badge-image" }}
                </div>
              {%- endif -%}
          {%- endif -%}
      </div>
  </div>

  {%- liquid
    assign unit_price = variant.unit_price
    assign unit_price_measurement = variant.unit_price_measurement
    assign unit_price = product.first_available_variant.unit_price
    assign unit_price_measurement = product.first_available_variant.unit_price_measurement
  -%}

  <div>
    {{  product_headline | image_url: width: 1500, format: 'jpg' | image_tag: widths: '375, 550, 750, 1100, 1500', alt:  product_image.alt, loading: 'lazy', class: 'history_image moonshine__images__product' }}

    <div class="moonshine__text"> 
    {%- if product.available -%}
      <span class="fullmoon">{{ product.variants[0].price | money }} </span><br>
      <span class="moonshine__text--small">{%- if unit_price_measurement -%}  {{ unit_price | money }}/{% if unit_price_measurement.reference_value != 1 %}{{ unit_price_measurement.reference_value }}{% endif %}{{ unit_price_measurement.reference_unit }}- 
    {%- endif -%}
      {%- if product.metafields.product.content -%}
      <span data-unit-price-measurement-quantity-value>{{ product.metafields.product.content }}</span>- 
    {%- elsif unit_price_measurement -%}
      <span data-unit-price-measurement-quantity-value>{{- unit_price_measurement.quantity_value | floor }}{{ unit_price_measurement.quantity_unit }}</span>- 
    {%- endif -%}

    {%- if product.metafields.product.alcohol -%}
      <span>{{ 'custom.alcohol' | t: value: product.metafields.product.alcohol }}</span>
    {%- endif -%}
    {%- else -%}
    <span class="fullmoon">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
    </div> </span>
  </div>

</a>
