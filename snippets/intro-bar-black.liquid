{% comment %}
    Renders the headline as h1 with black paint

    Usage:
    {% render 'intro-bar-black', title: page.title, subtitle: subtitle, text: text %}
{% endcomment %}

<div class="intro" style="background-image: url('{{ 'black-paint.png' | file_img_url: '900x' }}')">
    <h1 class="intro__title">{{title}}</h1>
    <h2 class="intro__subtitle">{{subtitle}}</h2>
    <p class="intro__text">{{text}}</p>
  </div>