{%- comment -%}
	Renders a product form with a button to bulk add recommended products to the 
  cart.

  Accepts:
  - products: {ProductListDrop} list of recommended products
  - section_id: {String}

  Usage:
  {%- render "product-recommended-products-bulk-add", products: recommended_products, section_id: section.id -%}

{%- endcomment -%}

{%- liquid
    comment
      Check all recommended products are available. Because 'products' is a 
      ProductListDrop we *can't* use the 'where' filter.
    endcomment
    assign all_products_available = true
    for recommended_product in products
      unless recommended_product.available
        assign all_products_available = false
        break
      endunless
    endfor
  
    assign product_form_id = 'recommended-product-' | append: section.id
  -%}
  
  {%- if all_products_available -%}
    <product-form>
      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        {%- for recommended_product in products -%}
          <input type="hidden" name="items[{{ forloop.index0 }}][id]" value="{{ recommended_product.first_available_variant.id }}"/>
          <input type="hidden" name="items[{{ forloop.index0 }}][quantity]" value="1"/>
        {%- endfor -%}
  
        <button
          id="{{ product_form_id }}-submit"
          type="submit"
          name="add"
          class="quick-add__submit button button--full-width button--primary"
          aria-haspopup="dialog"
          aria-live="polite"
        >
          <span>
            {{ button_text | default: 'Add all to cart' }}
          </span>
          <div class="loading-overlay__spinner hidden">
            <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
            </svg>
          </div>
        </button>
      {%- endform -%}
    </product-form>
  {%- endif -%}