          "settings": {
            "image": "shopify://shop_images/5_2.jpg",
            "overlay_title": false,
            "overlay_title_position": "bottom",
            "title": "",
            "text": "<p>Verbote steigern das Verlangen 3-fach. Statt Stress lieber bewusste Genussmomente schaffen.</p>",
            "mobile_text": "",
            "link_label": "",
            "link": "",
            "button_alignment": "left",
