          }
        },
        "column_6FeXxz": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/4_4.jpg",
            "overlay_title": false,
            "overlay_title_position": "bottom",
            "title": "",
            "text": "<p><strong>„Treat Yourself“-Momente erhöhen Zielerreichungen um 47%!</strong> Starte smarter ins neue Jahr – mit Genuss und Balance. „Try January“ heißt, sich die kleinen Freuden zu gönnen, die Großes bewirken.</p>",
