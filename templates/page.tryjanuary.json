          "settings": {
            "image": "shopify://shop_images/2_5.jpg",
            "overlay_title": false,
            "overlay_title_position": "bottom",
            "title": "",
            "text": "<p>76% aller Winter-Momente entstehen bei gemeinsamen Drinks. Also: Lieblingssorte schnappen, Freunde einladen, Erinnerungen schaffen. Die besten Stories schreibt man zusammen.</p>",
