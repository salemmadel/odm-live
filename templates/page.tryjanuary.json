          }
        },
        "column_EEUMha": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/3_2.jpg",
            "overlay_title": false,
            "overlay_title_position": "bottom",
            "title": "",
            "text": "<p>Fun Fact: Dein Gehirn schüttet bei neuen Geschmackserlebnissen extra viel Dopamin aus. Anders gesagt: Neue Geschmäcker machen glücklich! Worauf wartest du? Probier dich aus!</p>",
            "mobile_text": "",
            "link_label": "",
            "link": "",
