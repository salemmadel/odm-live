    "custom_liquid_7neYP3": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  CONFIGURATION - Edit these values as needed\n{% endcomment %}\n\n{% assign circle_image_url = \"https://cdn.shopify.com/s/files/1/0326/4859/3539/files/Untitled_design_8.png?v=1765273760\" %}\n{% assign rect_bg_color = \"#2c3e50\" %}\n{% assign rect_text_color = \"#ffffff\" %}\n{% assign section_padding = \"80px 20px\" %}\n{% assign rect_gap = \"30px\" %}\n\n{% comment %}\n  Text content for each rectangular (edit as needed)\n{% endcomment %}\n{% assign rect_1_text = \"Quality craftsmanship and attention to detail\" %}\n{% assign rect_2_text = \"Sustainable materials sourced responsibly\" %}\n{% assign rect_3_text = \"Innovative design for modern living\" %}\n{% assign rect_4_text = \"Exceptional customer service and support\" %}\n\n{% comment %}\n  Generate unique ID for this instance\n{% endcomment %}\n{% assign unique_id = 'radial-' | append: section.id %}\n\n<style>\n  @font-face {\n    font-family: 'GT Pressura Mono';\n    src: url('https://cdn.shopify.com/s/files/1/0326/4859/3539/files/GT-Pressura-Mono-Regular.woff2?v=1681482243') format('woff2');\n    font-weight: normal;\n    font-style: normal;\n    font-display: swap;\n  }\n\n  .radial-section-{{ unique_id }} {\n    padding: {{ section_padding }};\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 600px;\n  }\n\n  .radial-container-{{ unique_id }} {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 60px;\n    max-width: 1200px;\n    width: 100%;\n  }\n\n  .circle-image-{{ unique_id }} {\n    border-radius: 50%;\n    overflow: hidden;\n    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);\n    flex-shrink: 0;\n  }\n\n  .circle-image-{{ unique_id }} img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .rectangulars-container-{{ unique_id }} {\n    display: flex;\n    flex-direction: column;\n    gap: {{ rect_gap }};\n  }\n\n  .rectangular-{{ unique_id }} {\n    background: {{ rect_bg_color }};\n    color: {{ rect_text_color }};\n    padding: 20px 30px;\n    font-family: 'GT Pressura Mono', monospace;\n    font-size: 14px;\n    line-height: 1.6;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\n  }\n\n  /* All rectangulars horizontal */\n  .rect-1-{{ unique_id }},\n  .rect-2-{{ unique_id }},\n  .rect-3-{{ unique_id }},\n  .rect-4-{{ unique_id }} {\n    transform: rotate(0deg);\n  }\n\n  /* Mobile styles */\n  @media (max-width: 968px) {\n    .radial-container-{{ unique_id }} {\n      flex-direction: column;\n      gap: 40px;\n    }\n\n    .rectangulars-container-{{ unique_id }} {\n      width: 100%;\n      max-width: 500px;\n    }\n\n    .rectangular-{{ unique_id }} {\n      padding: 18px 25px;\n      font-size: 13px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .radial-section-{{ unique_id }} {\n      padding: 60px 15px;\n    }\n\n    .rectangulars-container-{{ unique_id }} {\n      gap: 25px;\n    }\n\n    .rectangular-{{ unique_id }} {\n      padding: 15px 20px;\n      font-size: 12px;\n    }\n\n    .rect-1-{{ unique_id }},\n    .rect-2-{{ unique_id }},\n    .rect-3-{{ unique_id }},\n    .rect-4-{{ unique_id }} {\n      transform: rotate(0deg);\n    }\n  }\n</style>\n\n<div class=\"radial-section-{{ unique_id }}\">\n  <div class=\"radial-container-{{ unique_id }}\">\n    <div class=\"circle-image-{{ unique_id }}\">\n      <img src=\"{{ circle_image_url }}\" alt=\"Circle Image\" loading=\"lazy\">\n    </div>\n\n    <div class=\"rectangulars-container-{{ unique_id }}\">\n      <div class=\"rectangular-{{ unique_id }} rect-1-{{ unique_id }}\">\n        {{ rect_1_text }}\n      </div>\n\n      <div class=\"rectangular-{{ unique_id }} rect-2-{{ unique_id }}\">\n        {{ rect_2_text }}\n      </div>\n\n      <div class=\"rectangular-{{ unique_id }} rect-3-{{ unique_id }}\">\n        {{ rect_3_text }}\n      </div>\n\n      <div class=\"rectangular-{{ unique_id }} rect-4-{{ unique_id }}\">\n        {{ rect_4_text }}\n      </div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_cdwKPc": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Announcement Bars Start -->\n<div id=\"announcement-bar-combined\">\n  <div class=\"announcement-line\">\n    <p>+++ Heiß begehrt & kurzzeitig zurück! +++</p>\n    \n    <p>+++ O'Donnell's Salzig-Süße Nuss Creme +++</p>\n    \n    \n  </div>\n</div>\n\n<!-- Mobile-only announcement bars -->\n<div id=\"announcement-bar-10\" class=\"mobile-only\">\n  <div class=\"announcement-line\">\n    <p> Heiß begehrt & kurzzeitig zurück! </p>\n  </div>\n</div>\n<div id=\"announcement-bar-15\" class=\"mobile-only\">\n  <div class=\"announcement-line\">\n    <p>O'Donnell's Salzig-Süße Nuss Creme</p>\n  </div>\n</div>\n\n\n\n<style>\n  @font-face {\n    font-family: 'Bitterbrush';\n    src: url('https://cdn.shopify.com/s/files/1/0326/4859/3539/files/Bitterbrush-Regular.otf?v=1758045747') format('opentype');\n    font-weight: normal;\n    font-style: normal;\n  }\n\n  /* Desktop: Single combined bar */\n  @media (min-width: 481px) {\n    :root {\n      --announcement-spacing: 80px;\n    }\n\n    .mobile-only {\n      display: none;\n    }\n\n    #announcement-bar-combined {\n      background-color: #60331e;\n      color: #d1bd9d;\n      padding: 10px 20px;\n      font-size: 20px;\n      font-weight: normal;\n      font-family: 'Bitterbrush', sans-serif;\n      text-align: center;\n      width: 100%;\n      margin: 0 auto 15px;\n      box-sizing: border-box;\n    }\n\n    #announcement-bar-combined .announcement-line {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      gap: var(--announcement-spacing);\n      width: 100%;\n    }\n\n    #announcement-bar-combined .announcement-line p {\n      margin: 0;\n      line-height: 1.4;\n      white-space: nowrap;\n    }\n\n    #announcement-bar-combined .separator-icon {\n      width: 20px;\n      height: 20px;\n    }\n  }\n\n  /* Mobile: Three separate bars */\n  @media (max-width: 480px) {\n    #announcement-bar-combined {\n      display: none;\n    }\n\n    .mobile-only {\n      background-color: #60331e;\n      color: #d1bd9d;\n      padding: 6px 10px;\n      font-size: 16px;\n      font-weight: normal;\n      font-family: 'Bitterbrush', sans-serif;\n      text-align: center;\n      width: 100%;\n      margin: 0 auto 2px;\n      box-sizing: border-box;\n    }\n\n    .announcement-line {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      gap: 6px;\n      width: 100%;\n    }\n\n    .announcement-line p {\n      margin: 0;\n      line-height: 1.4;\n    }\n  }\n</style>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
