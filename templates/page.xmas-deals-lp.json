    "custom_liquid_hp3iWe": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Custom Text Carousel -->\n<div class=\"custom-text-carousel\" style=\"background-color: #ede4d8; padding: 20px 0 40px 0; position: relative;\">\n\n  <div class=\"carousel-wrapper\">\n    <div class=\"carousel\">\n      <div class=\"carousel-item first\">\n        <div class=\"stars\">★★★★★</div>\n        \"Wir sind sehr zufrieden. Das Geschenk war super verpackt. Jederzeit wieder.\"\n        <div class=\"small-text\">MONIKA B.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Mit Bratapfel und Cookie genau die richtige Wahl getroffen für die Adventszeit.\"\n        <div class=\"small-text\">ARNE D.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Jeder hat seinen Favoriten, bin auf die Hart Nuss Cream gespannt die anderen waren sehr gut.\"\n        <div class=\"small-text\">MARTIN S.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★☆</div>\n        \"Sehr schnelle Lieferung und das Produkt ist sehr lecker nach Aussage von unserem Schwiegersohn. Ich kann die Box jedem empfehlen.\"\n        <div class=\"small-text\">SASCHA F.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Super schöne Verpackung!<br>Sehr stabil und da man<br>es mit jeder Sorte bestücken<br>kann ideal für jeden.\"\n        <div class=\"small-text\">ANDREAS H.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Die Geschenkbox sieht wirklich sehr schön aus. Wird natürlich vom Inhalt noch übertroffen. Und die Becher sind der Hammer.\"\n        <div class=\"small-text\">DOMINIK R.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"ADVENTSKALENDER IST SEIN PREIS WERT!!!!!\"\n        <div class=\"small-text\">SABINE K.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★☆</div>\n        \"Pralle Kirsche schmeckt sehr fein, Bratapfel noch ausbaufähig, an sich ein tolles Geschenk.\"\n        <div class=\"small-text\">HANNAH L.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Musste glatt ein 2. Bestellen weil es das 1. Nicht zum Empfänger geschafft hat und von meinem Mann und mir verkostet wurde.\"\n        <div class=\"small-text\">ALEXANDRA F.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"einfach toll vorallem<br>mit 2 becher mega.\"\n        <div class=\"small-text\">PATRICK B.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Die Produkte von Odonnell moonshine sind ein super Geschenk und und kommen bei allen gut an und werden Genossen.\"\n        <div class=\"small-text\">GUIDO C.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Sehr schöne Verpackung Der Harte Nuss Cream ist mega vom Geschmack her Die Becher sind der Knaller.\"\n        <div class=\"small-text\">DENISE G.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Ich liebe den Geschmack und deshalb habe ich die Box zum Verschenken gekauft. 100% Weiterempfehlung!\"\n        <div class=\"small-text\">MANUELA S.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Große Produktpalette, sehr gutschmeckende Produkte.\"\n        <div class=\"small-text\">CLAUDIA W.</div>\n      </div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★</div>\n        \"Immer wieder gern. Auch<br>super als Geschenk. Wir<br>mögen die nussigen Sorten<br>am liebsten.\"\n        <div class=\"small-text\">MARTINA W.</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Rectangular Dots Navigation -->\n  <div class=\"carousel-dots\"></div>\n  \n  <!-- Navigation Boxes Bottom Right -->\n  <div class=\"carousel-nav-boxes\">\n    <button class=\"nav-box nav-box-left\" aria-label=\"Previous\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <polyline points=\"15 18 9 12 15 6\"></polyline>\n      </svg>\n    </button>\n    <button class=\"nav-box nav-box-right\" aria-label=\"Next\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <polyline points=\"9 18 15 12 9 6\"></polyline>\n      </svg>\n    </button>\n  </div>\n</div>\n\n<style>\n/* Load GT Pressura Mono font */\n@font-face {\n  font-family: 'GT Pressura Mono';\n  src: url('https://cdn.shopify.com/s/files/1/0326/4859/3539/files/GT-Pressura-Mono-Regular.woff2?v=1681482243') format('woff2');\n  font-weight: normal;\n  font-style: normal;\n}\n\n/* Load GT Pressura Bold font */\n@font-face {\n  font-family: 'GT Pressura Bold';\n  src: url('https://cdn.shopify.com/s/files/1/0326/4859/3539/files/GT-Pressura-Bold.woff2?v=1754313265') format('woff2');\n  font-weight: bold;\n  font-style: normal;\n}\n\n.custom-text-carousel .carousel-wrapper {\n  overflow-x: auto;\n  scroll-behavior: smooth;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none; /* Firefox */\n  -ms-overflow-style: none; /* IE/Edge */\n}\n\n/* Hide scrollbar for Chrome, Safari and Opera */\n.custom-text-carousel .carousel-wrapper::-webkit-scrollbar {\n  display: none;\n}\n\n.custom-text-carousel .carousel {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: calc((100% - 45px)/4);\n  gap: 15px;\n  padding-bottom: 5px;\n}\n\n.custom-text-carousel .carousel-item.first {\n  margin-left: 50px;\n}\n\n.custom-text-carousel .carousel-item {\n  padding: 10px;\n  background: #ede4d8;\n  border-radius: 8px;\n  text-align: left;\n  font-family: 'GT Pressura Mono', monospace;\n  font-size: 16px;\n  white-space: normal;\n  word-break: break-word;\n  display: flex;\n  flex-direction: column;\n  margin-right: 50px;\n}\n\n.custom-text-carousel .carousel-item .stars {\n  color: #00b67a;\n  font-size: 18px;\n  margin-bottom: 5px;\n}\n\n.custom-text-carousel .carousel-item .small-text {\n  font-family: 'GT Pressura Bold', monospace;\n  font-size: 12px;\n  margin-top: 5px;\n  color: #333;\n}\n\n/* Navigation Boxes - Bottom Right */\n.custom-text-carousel .carousel-nav-boxes {\n  position: absolute;\n  bottom: 30px;\n  right: 50px;\n  display: flex;\n  gap: 10px;\n  z-index: 10;\n}\n\n.custom-text-carousel .nav-box {\n  width: 45px;\n  height: 45px;\n  background-color: #000;\n  border: none;\n  border-radius: 0;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: background-color 0.3s ease, transform 0.2s ease;\n}\n\n.custom-text-carousel .nav-box:hover {\n  background-color: #333;\n  transform: translateY(-5px);\n}\n\n/* Rectangular Dots Navigation */\n.custom-text-carousel .carousel-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 20px;\n  padding: 0 20px;\n  min-height: 10px;\n}\n\n.custom-text-carousel .dot {\n  width: 30px;\n  height: 6px;\n  background-color: #cccccc;\n  border-radius: 3px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.custom-text-carousel .dot.active {\n  background-color: #000000;\n  width: 40px;\n}\n\n.custom-text-carousel .dot:hover {\n  background-color: #666666;\n}\n\n/* Mobile: show 1 item at a time */\n@media (max-width: 768px) {\n  .custom-text-carousel .carousel {\n    grid-auto-columns: calc(100% - 20px);\n    gap: 15px;\n    scroll-snap-type: x mandatory;\n  }\n\n  .custom-text-carousel .carousel-item {\n    scroll-snap-align: start;\n    text-align: center;\n    justify-content: center;\n    align-items: center;\n    margin-right: 0;\n  }\n  \n  .custom-text-carousel .carousel-item.first {\n    margin-left: 10px;\n  }\n\n  .custom-text-carousel .carousel-wrapper {\n    scroll-behavior: auto;\n  }\n\n  .custom-text-carousel .dot {\n    width: 20px;\n    height: 5px;\n  }\n\n  .custom-text-carousel .dot.active {\n    width: 30px;\n  }\n\n  /* Navigation boxes on mobile */\n  .custom-text-carousel .carousel-nav-boxes {\n    bottom: 25px;\n    right: 20px;\n  }\n\n  .custom-text-carousel .nav-box {\n    width: 40px;\n    height: 40px;\n  }\n}\n</style>\n\n<script>\n(function() {\n  let updateActiveDot = null;\n  let wrapper = null;\n  let items = [];\n  let dots = [];\n  \n  const DESKTOP_VISIBLE_ITEMS = 4; \n  const MOBILE_VISIBLE_ITEMS = 1; \n\n  function checkIsMobile() {\n    return window.innerWidth <= 768;\n  }\n\n  function initCarousel() {\n    const carousel = document.querySelector('.custom-text-carousel .carousel');\n    wrapper = document.querySelector('.custom-text-carousel .carousel-wrapper');\n    const dotsContainer = document.querySelector('.custom-text-carousel .carousel-dots');\n    items = document.querySelectorAll('.custom-text-carousel .carousel-item');\n    const leftBox = document.querySelector('.custom-text-carousel .nav-box-left');\n    const rightBox = document.querySelector('.custom-text-carousel .nav-box-right');\n\n    if (!carousel || !wrapper || !dotsContainer || items.length === 0) {\n      setTimeout(initCarousel, 100);\n      return;\n    }\n\n    dotsContainer.innerHTML = '';\n    if (updateActiveDot) {\n      wrapper.removeEventListener('scroll', updateActiveDot);\n    }\n\n    const numReviews = items.length;\n    const isMobile = checkIsMobile();\n    const dotsToShow = isMobile ? MOBILE_VISIBLE_ITEMS : DESKTOP_VISIBLE_ITEMS;\n    const numPages = Math.ceil(numReviews / dotsToShow); \n\n    for (let i = 0; i < numPages; i++) {\n      const dot = document.createElement('div');\n      dot.classList.add('dot');\n      if (i === 0) dot.classList.add('active');\n      dot.setAttribute('data-index', i);\n\n      dot.addEventListener('click', function() {\n        const pageIndex = parseInt(this.getAttribute('data-index'));\n        scrollToPage(pageIndex);\n      });\n      dotsContainer.appendChild(dot);\n    }\n\n    dots = dotsContainer.querySelectorAll('.dot');\n\n    function scrollToPage(pageIndex) {\n      const isMobile = checkIsMobile();\n      const dotsToShow = isMobile ? MOBILE_VISIBLE_ITEMS : DESKTOP_VISIBLE_ITEMS;\n      const firstItemInPage = items[pageIndex * dotsToShow];\n      \n      if (firstItemInPage) {\n        const offset = isMobile ? 10 : 50;\n        wrapper.scrollTo({\n          left: firstItemInPage.offsetLeft - offset,\n          behavior: 'smooth'\n        });\n      }\n    }\n\n    function updateNavigationBoxes(currentPage) {\n      // Boxes are always visible now - no hiding logic\n    }\n\n    updateActiveDot = function() {\n      const wrapperScrollLeft = wrapper.scrollLeft;\n      const isMobile = checkIsMobile();\n      const itemsPerScreen = isMobile ? MOBILE_VISIBLE_ITEMS : DESKTOP_VISIBLE_ITEMS;\n      const firstItem = items[0];\n      \n      if (!firstItem) return;\n\n      let pageIndex = 0;\n      \n      if (isMobile) {\n        let minDistance = Infinity;\n        const wrapperCenter = wrapperScrollLeft + wrapper.offsetWidth / 2;\n\n        items.forEach(function(item, index) {\n          const itemCenter = item.offsetLeft + item.offsetWidth / 2;\n          const distance = Math.abs(itemCenter - wrapperCenter);\n\n          if (distance < minDistance) {\n            minDistance = distance;\n            pageIndex = index; // Changed from Math.floor(index / itemsPerScreen)\n          }\n        });\n      } else {\n        const firstItemMargin = 50;\n        const effectiveScrollStart = firstItem.offsetLeft - firstItemMargin;\n        const scrollDistance = wrapperScrollLeft - effectiveScrollStart;\n        const pageScrollWidth = items[3] ? items[3].offsetLeft - items[0].offsetLeft : items[0].offsetWidth * itemsPerScreen;\n        \n        if (pageScrollWidth > 0) {\n          pageIndex = Math.round(wrapperScrollLeft / pageScrollWidth);\n        } else {\n          pageIndex = 0;\n        }\n      }\n      \n      if (pageIndex >= dots.length) pageIndex = dots.length - 1;\n      if (pageIndex < 0) pageIndex = 0;\n\n      dots.forEach(function(dot, index) {\n        dot.classList.toggle('active', index === pageIndex);\n      });\n\n      // Update navigation box visibility\n      updateNavigationBoxes(pageIndex);\n    };\n\n    wrapper.addEventListener('scroll', updateActiveDot);\n\n    // Navigation box click handlers\n    if (leftBox) {\n      leftBox.addEventListener('click', function() {\n        const currentIndex = Array.from(dots).findIndex(d => d.classList.contains('active'));\n        const newIndex = Math.max(0, currentIndex - 1);\n        scrollToPage(newIndex);\n      });\n    }\n\n    if (rightBox) {\n      rightBox.addEventListener('click', function() {\n        const currentIndex = Array.from(dots).findIndex(d => d.classList.contains('active'));\n        const newIndex = Math.min(dots.length - 1, currentIndex + 1);\n        scrollToPage(newIndex);\n      });\n    }\n\n    setTimeout(function() {\n      updateActiveDot();\n      updateNavigationBoxes(0); // Initial state\n    }, 100);\n    \n    let isDown = false;\n    let startX;\n    let scrollLeft;\n\n    carousel.addEventListener('mousedown', function(e) {\n      isDown = true;\n      startX = e.pageX - carousel.offsetLeft;\n      scrollLeft = wrapper.scrollLeft;\n    });\n\n    carousel.addEventListener('mouseleave', function() { \n      isDown = false; \n    });\n    \n    carousel.addEventListener('mouseup', function() { \n      isDown = false; \n    });\n\n    carousel.addEventListener('mousemove', function(e) {\n      if (!isDown) return;\n      e.preventDefault();\n      const x = e.pageX - carousel.offsetLeft;\n      const walk = (x - startX) * 2;\n      wrapper.scrollLeft = scrollLeft - walk;\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initCarousel);\n  } else {\n    initCarousel();\n  }\n\n  window.addEventListener('load', function() {\n    setTimeout(initCarousel, 200);\n  });\n})();\n</script>",
