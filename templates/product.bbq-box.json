          }
        },
        "template--17918499782924__aad13389-b9cf-4d13-9347-0c02f8f34847-16818086767e69e669-1": {
          "type": "text",
          "settings": {
            "text": "<p>Natürlich darf ein leckerer Schluck von unserer Harten Nuss bei einem Grillabend nicht fehlen. Dafür haben wir für die BBQ Box extra eine \"Limited BBQ Edition\" kreiert. </p>",
            "text_style": "body"
          }
        }
      },
