        "template--17918499782924__ac887bee-8e82-4d19-8681-c03ad847ab49-16818086767e69e669-1": {
          "type": "text",
          "settings": {
            "text": "<p>Egal ob du damit ein deftiges Steak salzt, oder es für leckeres Grillgemüse nutzt - unser Rauchsalz passt immer und setzt hierbei nochmal neue geschmackliche Standards.</p>",
            "text_style": "body"
          }
        }
      },
