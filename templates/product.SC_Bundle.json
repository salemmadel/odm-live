{"sections": {"main": {"type": "main-product", "blocks": {"title": {"type": "title", "settings": {}}, "eshop_guide_product_usp_in9iQw": {"type": "eshop_guide_product_usp", "settings": {"usp_title": "Cremige Erdbeere für einen Sommer voller Geschmack und Genuss 🍓", "usp_1": "", "usp_2": "", "usp_3": "", "usp_4": "", "usp_5": ""}}, "caption": {"type": "text", "settings": {"text": "{{ product.metafields.descriptors.subtitle.value }}", "text_style": "subtitle"}}, "1b158f69-6012-451e-bf40-a205c86b3682": {"type": "shopify://apps/yotpo-product-reviews/blocks/star-rating/eb7dfd7d-db44-4334-bc49-c893b51b36cf", "settings": {"product": "strawberry-cream"}}, "price": {"type": "price", "settings": {}}, "description": {"type": "description", "settings": {}}, "variant_picker": {"type": "variant_picker", "settings": {"picker_type": "button"}}, "fd35310f-a903-4f2a-aa78-92f345583144": {"type": "link", "settings": {"title": "{{ product.metafields.custom.link_to_title.value }}"}}, "quantity_selector": {"type": "quantity_selector", "settings": {}}, "buy_buttons": {"type": "buy_buttons", "settings": {"show_sticky_cart": true, "is_set": false, "only_tier_gang_button": "Erforderliche Gangstufe nicht erreicht", "set_size": 3, "set_text": "Wähle 3 Produkte", "show_dynamic_checkout": false, "gang_url": "https://odonnell.de/account/login"}}, "wishlist_engine_product_page_mCQeFM": {"type": "shopify://apps/se-wishlist-engine/blocks/Product-Page/8f7c0857-8e71-463d-a168-8e133094753b", "settings": {}}, "collapsible-row-2": {"type": "collapsible_tab", "settings": {"heading": "Beschreibung", "icon": "clipboard", "content": "<p>Cremige Erdbeere für einen Sommer voller Geschmack und Genuss. Unser Erdbeer-Creme-Likör ist der perfekte Sommerdrink für jedes Sommerfest, die nächste Grill-Party oder einen entspannten Abend auf dem Balkon. Mit seiner cremigen Textur und dem intensiven Erdbeeraroma bietet er ein einzigartiges Geschmackserlebnis und wird vor allem unsere Cream & Fruchtigen Fans begeistern!</p>", "page": ""}}, "collapsible-row-3": {"type": "collapsible_tab", "settings": {"heading": "Cocktailvorschlag", "icon": "bottle", "content": "<h3><strong>Strawberry Cream Martini</strong></h3><ul><li>5 cl Strawberry & Cream</li><li>2 cl <a href=\"/products/vodka\" target=\"_blank\" title=\"Vodka\">Bio Vodka</a></li><li>1 cl Sahne</li><li>1 cl Vanillesirup (optional)</li><li>Eiswürfel</li><li>Deko: Erdbeere am Glasrand</li></ul><p>Alle Zutaten mit Eis im Shaker kräftig shaken und in ein gekühltes Martiniglas abseihen. Mit einer Erdbeere dekorieren.</p><p><strong>Tipp:</strong> Wer mag, rändert das Glas vorher mit etwas Zitronensaft und Zucker für den optischen Wow-Effekt.<em><br/></em><br/>Mehr Rezepte findest du in unserem <a href=\"/blogs/cocktails\" title=\"Cocktails\">Cocktails-Blog</a>.</p>", "page": ""}}, "collapsible_tab_ByBJPW": {"type": "collapsible_tab", "settings": {"heading": "Allergen-Hinweis & Inhaltsstoffe", "icon": "dairy_free", "content": "<p>Enthält Farbstoff (E129), Milch und Milcherzeugnisse!</p>", "page": ""}}, "collapsible-row-1": {"type": "collapsible_tab", "settings": {"heading": "Komm in die O'Donnell Gang", "icon": "silhouette", "content": "<p>Werde Teil der <a href=\"/pages/gang\" title=\"Die O'Donnell Gang\">Moonshine-Gang</a>! Als Mitglied sammelst du mit jedem Kauf im Onlineshop Proof und kannst diese gegen gratis O’Donnell Geschenke eintauschen. Außerdem hast du Zugang zu exklusiven Produkten und kannst im Gang-Rang immer weiter aufsteigen. Worauf wartest du also noch?</p>", "page": ""}}, "collapsible-row-0": {"type": "collapsible_tab", "settings": {"heading": "Versand", "icon": "truck", "content": "<ul><li><strong>DHL Priority: Lieferzeit 1-2 Werktage</strong></li></ul><p>Alle Bestellungen bis 12 Uhr werden noch am selben Tag DHL übergeben.</p><ul><li><strong>DHL Standard: Lieferzeit 2-3 Werktage</strong></li></ul>", "page": ""}}, "recommended_products_3FHMHQ": {"type": "recommended_products", "settings": {"title": "Entdecke unsere Bestseller", "content": "", "button_text": "", "product_list": ["pralle-kirsche-kirschlikoer", "harte-nuss", "wilde-beere", "toffee", "bratapfel"], "enable_bulk_add": false, "columns_desktop": "2", "enable_desktop_slider": true, "columns_mobile": "2", "swipe_on_mobile": true}}, "availability_message": {"type": "availability_message", "settings": {"show_availability_message": true, "availability_text": "Available from now"}}}, "block_order": ["title", "eshop_guide_product_usp_in9iQw", "caption", "1b158f69-6012-451e-bf40-a205c86b3682", "price", "description", "variant_picker", "fd35310f-a903-4f2a-aa78-92f345583144", "quantity_selector", "availability_message", "buy_buttons", "wishlist_engine_product_page_mCQeFM", "collapsible-row-2", "collapsible-row-3", "collapsible_tab_ByBJPW", "collapsible-row-1", "collapsible-row-0", "recommended_products_3FHMHQ"], "settings": {"gift_card_receipient_enabled": false, "is_above_the_fold": true, "enable_sticky_info": true, "badges_enabled": false, "gallery_layout": "thumbnail", "media_size": "small", "mobile_thumbnails": "hide", "hide_variants": true, "enable_video_looping": false, "padding_top": 12, "padding_bottom": 12}}, "ss_scrolling_anouncement_bar_68RGbc": {"type": "ss-scrolling-anouncement-bar", "blocks": {"text_DJwnhe": {"type": "text", "settings": {"text": "Kostenloser Versand ab 75€"}}, "text_NpzNY7": {"type": "text", "settings": {"text": "In 2-3 Werktagen bei Dir"}}, "text_6XfUCP": {"type": "text", "settings": {"text": "Perfekt für den Sommer"}}, "text_AFWPM8": {"type": "text", "settings": {"text": "Mit Klarna jetzt kaufen & später bezahlen"}}}, "block_order": ["text_DJwnhe", "text_NpzNY7", "text_6XfUCP", "text_AFWPM8"], "name": "t:sections.ss-announcement-bar.presets.name", "settings": {"insert_css_class_target": "", "layout": "grid", "text_size": 14, "link": "", "animation_duration": 78, "animation_direction": "left", "pause_hover": false, "bg": "#6f0117", "text_color": "#ffffff", "hover_opacity": 90, "padding_horizonta