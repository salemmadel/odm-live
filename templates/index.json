-overflow-scrolling: touch;\n    gap: 20px;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n  }\n  .columns-wrapper::-webkit-scrollbar {\n    display: none;\n  }\n\n  .column {\n    flex: 0 0 70%;\n    max-width: 70%;\n    scroll-snap-align: center;\n  }\n\n  \/* Mobile text overlay *\/\n  .overlay-text {\n    font-size: 35px;\n    margin-top: 60px;\n  }\n  .overlay-text .line1 {\n    margin-bottom: -35px;\n  }\n  .overlay-text .line2 {\n    margin-top: -5px;\n    margin-bottom: 5px;\n  }\n\n  .columns-heading {\n    font-size: 32px;\n    margin-bottom: 20px;\n  }\n  .scroll-indicators {\n    text-align: center;\n    margin-top: 15px;\n  }\n  .scroll-indicators .dot {\n    height: 10px;\n    width: 10px;\n    margin: 0 5px;\n    background-color: #bbb;\n    border-radius: 50%;\n    display: inline-block;\n    transition: background-color 0.3s;\n    cursor: pointer;\n  }\n  .scroll-indicators .dot.active {\n    background-color: #333;\n  }\n}\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const wrapper = document.getElementById(\"scrollable-columns\");\n  const dots = document.querySelectorAll(\"#scroll-indicators .dot\");\n\n  \/\/ Update active dot when scrolling\n  wrapper.addEventListener(\"scroll\", () => {\n    const scrollLeft = wrapper.scrollLeft;\n    const width = wrapper.offsetWidth;\n    const index = Math.round(scrollLeft \/ width);\n\n    dots.forEach((dot, i) => {\n      dot.classList.toggle(\"active\", i === index);\n    });\n  });\n\n  \/\/ Scroll to image when dot is clicked\n  dots.forEach((dot) => {\n    dot.addEventListener(\"click\", () => {\n      const index = dot.getAttribute(\"data-index\");\n      const columnWidth = wrapper.offsetWidth;\n      wrapper.scrollTo({\n        left: index * columnWidth,\n        behavior: \"smooth\"\n      });\n    });\n  });\n});\n<\/script>","color_scheme":"background-1","padding_top":0,"padding_bottom":52}},"7bf3e930-9a71-43ba-8a6a-ff90123d3951":{"typ