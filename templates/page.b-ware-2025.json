e":"Stimmen zu unseren B-WARE.","background_color":"#000000","text_color":"#ffffff","headline_color":"#ffffff","border_bottom_color":"#ffffff","padding_top":30,"padding_bottom":0}},"custom_liquid_fcdUmY":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<!-- Custom Text Carousel -->\n<div class=\"custom-text-carousel\" style=\"background-color: #000; padding: 20px 0 40px 0; position: relative;\">\n\n  <div class=\"carousel-wrapper\">\n    <div class=\"carousel\">\n      <div class=\"carousel-item first\">\n        <div class=\"stars\">★★★★★<\/div>\n        \"BWare ohne Qualitätsverlust.\"\n        <div class=\"small-text\">KATRIN<\/div>\n      <\/div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★<\/div>\n        \"Alles supi schnell abgewickelt Man sieht gar nicht das es bware ist.\n\"\n        <div class=\"small-text\">ROCOO V.<\/div>\n      <\/div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★<\/div>\n        \"BWare und genau so gut wie A Ware, wenn nicht noch besser\n\"\n        <div class=\"small-text\">JONAS T.<\/div>\n      <\/div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★☆<\/div>\n        \"Super quali passt perfekt auf die Gläser.\"\n        <div class=\"small-text\">MARCO L.<\/div>\n      <\/div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★<\/div>\n        \"Super lecker! Kaum zu sehen das es BWare ist.\"\n        <div class=\"small-text\">ANDREAS S.<\/div>\n      <\/div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★<\/div>\n        \"wie immer schnell und\nin gewohnter Quali.\n\"\n        <div class=\"small-text\">NADINE S.<\/div>\n      <\/div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★★<\/div>\n        \"Mega. Lecker wie immer.\"\n        <div class=\"small-text\">FAAS B.<\/div>\n      <\/div>\n      <div class=\"carousel-item\">\n        <div class=\"stars\">★★★★☆<\/div>\n        \"Super.\"\n        <div class=\"small-text\">BIRGIT S.<\/div>\n      <\/div>\n      <div class=\"carousel-item\"><\/div>\n    <\/div>\n  <\/div>\n  \n  <!-- Rectangular Dots Navigation -->\n  <div class=\"carousel-dots\"><\/div>\n  \n  <!-- Navigation Boxes Bottom Right -->\n  <div class=\"carousel-nav-boxes\">\n    <button class=\"nav-box nav-box-left\" aria-label=\"Previous\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <polyline points=\"15 18 9 12 15 6\"><\/polyline>\n      <\/svg>\n    <\/button>\n    <button class=\"nav-box nav-box-right\" aria-label=\"Next\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <polyline points=\"9 18 15 12 9 6\"><\/polyline>\n      <\/svg>\n    <\/button>\n  <\/div>\n<\/div>\n\n<style>\n\/* Load GT Pressura Mono font *\/\n@font-face {\n  font-family: 'GT Pressura Mono';\n  src: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0326\/4859\/3539\/files\/GT-Pressura-Mono-Regular.woff2?v=1681482243') format('woff2');\n  font-weight: normal;\n  font-style: normal;\n}\n\n\/* Load GT Pressura Bold font *\/\n@font-face {\n  font-family: 'GT Pressura Bold';\n  src: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0326\/4859\/3539\/files\/GT-Pressura-Bold.woff2?v=1754313265') format('woff2');\n  font-weight: bold;\n  font-style: normal;\n}\n\n.custom-text-carousel .carousel-wrapper {\n  overflow-x: auto;\n  scroll-behavior: smooth;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n}\n\n.custom-text-carousel .carousel-wrapper::-webkit-scrollbar {\n  display: none;\n}\n\n.custom-text-carousel .carousel {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: calc((100% - 45px)\/4);\n  gap: 15px;\n  padding-bottom: 5px;\n}\n\n.custom-text-carousel .carousel-item.first {\n  margin-left: 50px;\n}\n\n.custom-text-carousel .carousel-item {\n  padding: 10px;\n  background: #000;\n  border-radius: 8px;\n  text-align: left;\n  font-family: 'GT Pressura Mono', monospace;\n  font-size: 16px;\n  white-space: normal;\n  word-break: break-word;\n  display: flex;\n  flex-direction: column;\n  margin-right: 50px;\n  color: #fff;\n}\n\n.custom-text-carousel .carousel-item .stars {\n  color: #00b67a;\n  font-size: 18px;\n  margin-bottom: 5px;\n}\n\n.custom-text-carousel .carousel-item .small-text {\n  font-family: 'GT Pressura Bold', monospace;\n  font-size: 12px;\n  margin-top: 5px;\n  color: #fff;\n}\n\n\/* Navigation Boxes *\/\n.custom-text-carousel .carousel-nav-boxes {\n  position: absolute;\n  bottom: 30px;\n  right: 50px;\n  display: flex;\n  gap: 10px;\n  z-index: 10;\n}\n\n.custom-text-carousel .nav-box {\n  width: 45px;\n  height: 45px;\n  background-color: #000;\n  border: none;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: background-color 0.3s ease, transform 0.2s ease;\n}\n\n.custom-text-carousel .nav-box:hover {\n  background-color: #333;\n  transform: translateY(-5px);\n}\n\n\/* Dots *\/\n.custom-text-carousel .carousel-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 20px;\n  padding: 0 20px;\n  min-height: 10px;\n}\n\n.custom-text-carousel .dot {\n  width: 30px;\n  height: 6px;\n  background-color: #666;\n  border-radius: 3px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.custom-text-carousel .dot.active {\n  background-color: #fff;\n  width: 40px;\n}\n\n.custom-text-carousel .dot:hover {\n  background-color: #999;\n}\n\n\/* Mobile *\/\n@media (max-width: 768px) {\n  .custom-text-carousel .carousel {\n    grid-auto-columns: calc(100% - 20px);\n    gap: 15px;\n    scroll-snap-type: x mandatory;\n  }\n\n  .custom-text-carousel .carousel-item {\n    scroll-snap-align: start;\n    text-align: center;\n    justify-content: center;\n    align-items: center;\n    margin-right: 0;\n  }\n  \n  .custom-text-carousel .carousel-item.first {\n    margin-left: 10px;\n  }\n\n  .custom-text-carousel .carousel-wrapper {\n    scroll-behavior: auto;\n  }\n\n  .custom-text-carousel .dot {\n    width: 20px;\n    height: 5px;\n  }\n\n  .custom-text-carousel .dot.active {\n    width: 30px;\n  }\n\n  .custom-text-carousel .carousel-nav-boxes {\n    bottom: 25px;\n    right: 20px;\n  }\n\n  .custom-text-carousel .nav-box {\n    width: 40px;\n    height: 40px;\n  }\n}\n<\/style>\n\n<script>\n(function() {\n  let updateActiveDot = null;\n  let wrapper = null;\n  let items = [];\n  let dots = [];\n  \n  const DESKTOP_VISIBLE_ITEMS = 4; \n  const MOBILE_VISIBLE_ITEMS = 1; \n\n  function checkIsMobile() {\n    return window.innerWidth <= 768;\n  }\n\n  function initCarousel() {\n    const carousel = document.querySelector('.custom-text-carousel .carousel');\n    wrapper = document.querySelector('.custom-text-carousel .carousel-wrapper');\n    const dotsContainer = document.querySelector('.custom-text-carousel .carousel-dots');\n    items = document.querySelectorAll('.custom-text-carousel .carousel-item');\n    const leftBox = document.querySelector('.custom-text-carousel .nav-box-left');\n    const rightBox = document.querySelector('.custom-text-carousel .nav-box-right');\n\n    if (!carousel || !wrapper || !dotsContainer || items.length === 0) {\n      setTimeout(initCarousel, 100);\n      return;\n    }\n\n    dotsContainer.innerHTML = '';\n    if (updateActiveDot) {\n      wrapper.removeEventListener('scroll', updateActiveDot);\n    }\n\n    const numReviews = items.length;\n    const isMobile = checkIsMobile();\n    const dotsToShow = isMobile ? MOBILE_VISIBLE_ITEMS : DESKTOP_VISIBLE_ITEMS;\n    const numPages = Math.ceil(numReviews \/ dotsToShow);\n\n    for (let i = 0; i < numPages; i++) {\n      const dot = document.createElement('div');\n      dot.classList.add('dot');\n      if (i === 0) dot.classList.add('active');\n      dot.setAttribute('data-index', i);\n\n      dot.addEventListener('click', function() {\n        const pageIndex = parseInt(this.getAttribute('data-index'));\n        scrollToPage(pageIndex);\n      });\n      dotsContainer.appendChild(dot);\n    }\n\n    dots = dotsContainer.querySelectorAll('.dot');\n\n    function scrollToPage(pageIndex) {\n      const isMobile = checkIsMobile();\n      const dotsToShow = isMobile ? MOBILE_VISIBLE_ITEMS : DESKTOP_VISIBLE_ITEMS;\n      const firstItemInPage = items[pageIndex * dotsToShow];\n      \n      if (firstItemInPage) {\n        const offset = isMobile ? 10 : 50;\n        wrapper.scrollTo({\n          left: firstItemInPage.offsetLeft - offset,\n          behavior: 'smooth'\n        });\n      }\n    }\n\n    function updateNavigationBoxes(currentPage) {}\n\n    updateActiveDot = function() {\n      const wrapperScrollLeft = wrapper.scrollLeft;\n      const isMobile = checkIsMobile();\n      const itemsPerScreen = isMobile ? MOBILE_VISIBLE_ITEMS : DESKTOP_VISIBLE_ITEMS;\n      const firstItem = items[0];\n      \n      if (!firstItem) return;\n\n      let pageIndex = 0;\n      \n      if (isMobile) {\n        let minDistance = Infinity;\n        const wrapperCenter = wrapperScrollLeft + wrapper.offsetWidth \/ 2;\n\n        items.forEach(function(item, index) {\n          const itemCenter = item.offsetLeft + item.offsetWidth \/ 2;\n          const distance = Math.abs(itemCenter - wrapperCenter);\n\n          if (distance < minDistance) {\n            minDistance = distance;\n            pageIndex = index;\n          }\n        });\n      } else {\n        const firstItemMargin = 50;\n        const effectiveScrollStart = firstItem.offsetLeft - firstItemMargin;\n        const scrollDistance = wrapperScrollLeft - effectiveScrollStart;\n        const pageScrollWidth = items[3] ? items[3].offsetLeft - items[0].offsetLeft : items[0].offsetWidth * itemsPerScreen;\n        \n        if (pageScrollWidth > 0) {\n          pageIndex = Math.round(wrapperScrollLeft \/ pageScrollWidth);\n        } else {\n          pageIndex = 0;\n        }\n      }\n      \n      if (pageIndex >= dots.length) pageIndex = dots.length - 1;\n      if (pageIndex < 0) pageIndex = 0;\n\n      dots.forEach(function(dot, index) {\n        dot.classList.toggle('active', index === pageIndex);\n      });\n\n      updateNavigationBoxes(pageIndex);\n    };\n\n    wrapper.addEventListener('scroll', updateActiveDot);\n\n    if (leftBox) {\n      leftBox.addEventListener('click', function() {\n        const currentIndex = Array.from(dots).findIndex(d => d.classList.contains('active'));\n        const newIndex = Math.max(0, currentIndex - 1);\n        scrollToPage(newIndex);\n      });\n    }\n\n    if (rightBox) {\n      rightBox.addEventListener('click', function() {\n        const currentIndex = Array.from(dots).findIndex(d => d.classList.contains('active'));\n        const newIndex = Math.min(dots.length - 1, currentIndex + 1);\n        scrollToPage(newIndex);\n      });\n    }\n\n    setTimeout(function() {\n      updateActiveDot();\n      updateNavigationBoxes(0);\n    }, 100);\n    \n    let isDown = false;\n    let startX;\n    let scrollLeft;\n\n    carousel.addEventListener('mousedown', function(e) {\n      isDown = true;\n      startX = e.pageX - carousel.offsetLeft;\n      scrollLeft = wrapper.scrollLeft;\n    });\n\n    carousel.addEventListener('mouseleave', function() { \n      isDown = false; \n    });\n    \n    carousel.addEventListener('mouseup', function() { \n      isDown = false; \n    });\n\n    carousel.addEventListener('mousemove', function(e) {\n      if (!isDown) return;\n      e.preventDefault();\n      const x = e.pageX - carousel.offsetLeft;\n      const walk = (x - startX) * 2;\n      wrapper.scrollLeft = scrollLeft - walk;\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initCarousel);\n  } e