            "overlay_title": false,
            "overlay_title_position": "bottom",
            "title": "Jan",
            "text": "<p>Bei O’Donnell Moonshine zu arbeiten bedeutet für mich stetiges Wachstum, ein tolles Teamgefühl und viele Möglichkeiten, sich selbst weiterzuentwickeln.</p>",
            "mobile_text": "",
            "link_label": "",
