            "overlay_title": false,
            "overlay_title_position": "bottom",
            "title": "Richard",
            "text": "<p>O’Donnell ist für mich Familie, Passion und der geilste Schnaps der Welt.</p>",
            "mobile_text": "",
            "link_label": "",
            "link": "",
            "button_alignment": "left",
            "selected_button": false,
