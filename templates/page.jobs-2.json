            "overlay_title": false,
            "overlay_title_position": "bottom",
            "title": "Jess",
            "text": "<p>Die Zusammenarbeit mit meinem talentierten Team und die dynamische Unternehmenskultur machen O'Donnell Moonshine zu einem großartigen Arbeitsplatz für mich.</p>",
            "mobile_text": "",
            "link_label": "",
