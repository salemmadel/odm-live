": "t:sections.custom-liquid.presets.name", "settings": {"custom_liquid": "<div class=\"carousel-container\" style=\"max-width: 1195px; margin: 0 auto; padding: 40px; position: relative; overflow: hidden; background: #ffffff;\">\n\n<div style=\"max-width: 1195px; margin: 0 auto; padding: 40px; position: relative; overflow: hidden; background: #fffff;\">\n  \n  <!-- Slide 1 -->\n  <div class=\"carousel-slide\" style=\"display: block; position: relative;\">\n    <div style=\"display: flex; align-items: center;\">\n      <!-- Image -->\n      <div style=\"flex: 1; min-width: 550px; max-width: 1500px; max-height: 1500px; overflow: hidden;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0326/4859/3539/files/PDP_Gallery-2xWhisky_2.jpg?v=1752563295\" alt=\"Slide 1\" style=\"width: 100%; height: auto; display: block;\">\n      </div>\n      <!-- Text box -->\n      <div style=\"\n        background: #EFEAE4;\n        padding: 40px;\n        margin-left: -30px;\n        max-width: 700px;\n        position: relative;\n        z-index: 2;\n        box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n      \">\n        <h2>Fruchtig, wild & fassveredelt</h2>\n       <p style=\"text-align: justify;\">\n  <strong>Blueberry Moonshine</strong> kombiniert natürliche <strong>Heidelbeere, Vanille und Toffee</strong> mit echtem <strong>Single Malt Whiskey</strong> von St. Kilian. Gereift in Ex-Bourbon-Fässern. <strong>30 % vol.</strong> – perfekt pur, auf Eis oder im Cocktail.\n</p>\n\n      </div>\n    </div>\n  </div>\n\n  <!-- Slide 2 -->\n  <div class=\"carousel-slide\" style=\"display: none; position: relative;\">\n    <div style=\"display: flex; align-items: center;\">\n      <div style=\"flex: 1; min-width: 550px; max-width: 1500px; max-height: 1500px; overflow: hidden;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0326/4859/3539/files/PDP_Landingpage-Content_2_bad1e34f-f25d-4352-9e73-749096f140dd.jpg?v=1752558830\" alt=\"Slide 2\" style=\"width: 100%; height: auto; display: block;\">\n      </div>\n      <div style=\"background: #EFEAE4; padding: 40px; margin-left: -100px; z-index: 2; position: relative; max-width: 700px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);\">\n        <h2>So schmeckt’s am besten</h2>\n        <p><strong>Blueberry Moonshine</strong> schmeckt pur, auf Eis oder im Drink – genau so, wie du’s magst. <strong>Fruchtig, mild und charakterstark</strong> passt er zu BBQs, Picknicks oder langen Sommerabenden.\nAm besten serviert im Original <strong>O’Donnell Tumbler:</strong>schweres Glas, klarer Stil. Genau das Richtige für echten Geschmack!\n\n</p>\n      \n      </div>\n    </div>\n  </div>\n\n  \n\n  <!-- Nav buttons -->\n  <button onclick=\"plusSlides(-1)\" style=\"\n    position: absolute; \n    top: 50%; \n    left: 50px; \n    transform: translateY(-50%);\n    width: 40px; \n    height: 40px; \n    border-radius: 50%; \n    border: none; \n    background: rgba(0,0,0,0.2); \n    color: #fff; \n    font-size: 20px; \n    cursor: pointer;\n    z-index: 9999;\n  \">❮</button>\n\n  <button onclick=\"plusSlides(1)\" style=\"\n    position: absolute; \n    top: 50%; \n    right: 50px; \n    transform: translateY(-50%);\n    width: 40px; \n    height: 40px; \n    border-radius: 50%; \n    border: none; \n    background: rgba(0,0,0,0.2); \n    color: #fff; \n    font-size: 20px; \n    cursor: pointer;\n    z-index: 9999;\n  \">❯</button>\n\n</div>\n</div>\n\n<style>\n  @media screen and (max-width: 768px) {\n    .carousel-container {\n      display: none;\n    }\n  }\n\n.carousel-container {\n      padding: 20px 40px 0px 0px !important; /* Only top, left, right padding */\n      margin-bottom: 0px !important;\n    }\n\n .carousel-container > div {\n      padding: 40px 40px 0 40px !important; /* Only top, left, right padding */\n      margin-bottom: 0 !important;\n    }\n  }\n</style>\n\n\n<script>\n  (function(){\n    var container = document.querySelector('.carousel-container');\n    var slides = container.getElementsByClassName(\"carousel-slide\");\n    var slideIndex = 0;\n\n    function showSlides(n) {\n      if (n >= slides.length) { slideIndex = 0; }\n      if (n < 0) { slideIndex = slides.length - 1; }\n      for (var i = 0; i < slides.length; i++) {\n        slides[i].style.display = \"none\";\n      }\n      slides[slideIndex].style.display = \"block\";\n    }\n\n    function plusSlides(n) {\n      slideIndex += n;\n      showSlides(slideIndex);\n    }\n\n    container.querySelectorAll('button')[0].onclick = function() { plusSlides(-1); };\n    container.querySelectorAll('button')[1].onclick = function() { plusSlides(1); };\n\n    showSlides(slideIndex);\n  })();\n</script>", "color_scheme": "background-1", "padding_top": 0, "padding_bottom": 0}}, "custom_liquid_M6Xydw": {"type": "custom-liquid", "disabled": true, "name": "t:sections.custom-liquid.presets.name", "settings": {"custom_liquid": "<section class=\"carousel-wrapper\">\n<div class=\"mobile-only\">\n  <div class=\"custom-carousel\">\n    <!-- Slide 1: Image -->\n    <div class=\"carousel-slide active\">\n      <div class=\"image-container\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0326/4859/3539/files/PDP_Gallery-2xWhisky_2.jpg?v=1752563295\" alt=\"Slide 1\">\n      </div>\n    </div>\n\n    <!-- Slide 2: Text -->\n    <div class=\"carousel-slide\">\n      <div class=\"text-slide\">\n        <h3>Fruchtig, wild & fassveredelt</h3>\n        <p style=\"text-align: justify;\">\n  <strong>Blueberry Moonshine</strong> kombiniert natürliche <strong>Heidelbeere, Vanille und Toffee</strong> mit echtem <strong>Single Malt Whiskey</strong> von St. Kilian. Gereift in Ex-Bourbon-Fässern. <strong>30 % vol.</strong> – perfekt pur, auf Eis oder im Cocktail.\n</p>\n      </div>\n    </div>\n\n    <!-- Slide 3: Image -->\n    <div class=\"carousel-slide\">\n      <div class=\"image-container\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0326/4859/3539/files/PDP_Landingpage-Content_2_bad1e34f-f25d-4352-9e73-749096f140dd.jpg?v=1752558830\" alt=\"Slide 3\">\n      </div>\n    </div>\n\n    <!-- Slide 4: Text -->\n    <div class=\"carousel-slide\">\n      <div class=\"text-slide\">\n        <h3>So schmeckt’s am besten\n</h3>\n        <p><strong>Blueberry Moonshine</strong> schmeckt pur, auf Eis oder im Drink – genau so, wie du’s magst. <strong>Fruchtig, mild und charakterstark</strong> passt er zu BBQs, Picknicks oder langen Sommerabenden.\nAm besten serviert im Original <strong>O’Donnell Tumbler:</strong>schweres Glas, klarer Stil. Genau das Richtige für echten Geschmack!\n\n</p>\n      </div>\n    </div>\n\n    <!-- Slide 5: Image  -->\n    <div class=\"carousel-slide\">\n      <div class=\"image-container\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0326/4859/3539/files/PDP_Gallery-1xTumbler_1.jpg?v=1752503782\" alt=\"Slide 5\">\n      </div>\n    </div>\n\n    <!-- Slide 6: Text  -->\n    <div class=\"carousel-slide\">\n      <div class=\"text-slide\">\n        <h3>Dreh dich zum Genuss</h3>\n        \n        <p style=\"margin-top: 1em;\">\n          Der Tumbler überzeugt mit strukturiertem Design für optimalen Grip und einem drehbaren Boden, der Aromen freisetzt. Perfekt für Whiskey & Co., inklusive stilvollem Bambus-Untersetzer – das ideale Glas für Genießer:innen oder als originelles Geschenk.\n        </p>\n      </div>\n    </div>\n\n    <!-- Slide 7: Image -->\n    <div class=\"carousel-slide\">\n      <div class=\"image-container\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0326/4859/3539/files/PDP_Landingpage-Content_3.jpg?v=1752651400\" alt=\"Slide 7\">\n      </div>\n    </div>\n\n    <!-- Slide 8: Text -->\n    <div class=\"carousel-slide\">\n      <div class=\"text-slide\">\n        <h3>Mehr Storytelling</h3>\n        <p>\n          Ergänze diese Textfolie mit weiteren Infos, Rezeptideen oder spannenden Fakten rund um deine Produkte.\n        </p>\n      </div>\n    </div>\n\n    <!-- Controls -->\n    <button class=\"carousel-prev\">‹</button>\n    <button class=\"carousel-next\">›</button>\n  </div>\n</div>\n\n<style>\n  .mobile-only {\n    display: block;\n    margin: 0;\n    padding: 0;\n  }\n\n@media (min-width: 769px) {\n  .carousel-wrapper,\n  .mobile-only {\n    display: none !important;\n    height: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n}\n\n\n  .custom-carousel {\n    position: relative;\n    width: 100%;\n    max-width: 600px;\n    margin: 0 auto;\n    overflow: hidden;\n  }\n\n  .carousel-slide {\n    display: none;\n    text-align: center;\n  }\n\n  .carousel-slide.active {\n    display: block;\n  }\n\n  .image-container {\n    max-width: 500px;\n    margin: 0 auto;\n  }\n\n  .image-container img {\n    width: 100%;\n    height: auto;\n    display: block;\n  }\n\n  .text-slide {\n    max-width: 80%;\n    margin: 0 auto;\n    text-align: justify;\n  }\n\n  .text-slide h3 {\n    font-size: 15px;\n    font-weight: bold;\n    margin-bottom: 10px;\n    text-align: center;\n  }\n\n  .text-slide p {\n    font-size: 14px;\n    color: #333;\n    line-height: 1.6;\n  }\n\n  .carousel-prev,\n  .carousel-next {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    background: #2c2c2c;\n    color: #fff;\n    border: none;\n    font-size: 24px;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    opacity: 0.5;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: opacity 0.3s ease;\n  }\n\n  .carousel-prev:hover,\n  .carousel-next:hover {\n    opacity: 0.8;\n  }\n\n  .carousel-prev {\n    left: 10px;\n  }\n\n  .carousel-next {\n    right: 10px;\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const carousel = document.querySelector('.custom-carousel');\n    if (!carousel) return;\n\n    const slides = carousel.querySelectorAll('.carousel-slide');\n    const prevBtn = carousel.querySelector('.carousel-prev');\n    const nextBtn = carousel.querySelector('.carousel-next');\n    let currentSlide = 0;\n\n    function showSlide(index) {\n      slides.forEach((slide, i) => {\n        slide.classList.toggle('active', i === index);\n      });\n    }\n\n    prevBtn.addEventListener('click', () => {\n      currentSlide = (currentSlide - 1 + slides.length) % slides.length;\n      showSlide(currentSlide);\n    });\n\n    nextBtn.addEventListener('click', () => {\n      currentSlide = (currentSlide + 1) % slides.length;\n      showSlide(currentSlide);\n    });\n\n    showSlide(currentSlide);\n  });\n</script>", "color_scheme": "background-1", "padding_top": 40, "padding_bottom": 52}}, "product-recommendations": {"type": "product-recommendations", "disabled": true, "settings": {"heading": "Das könnte dir auch gefallen", "heading_size": "h2", "products_to_show": 4, "columns_desktop": 4, "color_scheme": "background-1", "image_ratio": "square", "show_secondary_image": true, "show_vendor": false, "show_rating": false, "grey_sold_out_products": true, "columns_mobile": "2", "padding_top": 24, "padding_bottom": 12}}, "featured_collection_xnLMT8": {"type": "featured-collection", "settings": {"is_above_the_fold": false, "title": "Unsere Bestseller", "heading_size": "h2", "description": "", "show_description": false, "grey_sold_out_products": true, "description_style": "body", "collection": "featured", "products_to_show": 4, "columns_desktop": 4, "full_width": false, "section_animation": "none", "show_view_all": true, "view_all_style": "solid", "view_all_button_label": "ALLE PRODUKTE ANSEHEN", "enable_desktop_slider": true, "color_scheme": "background-1", "image_ratio": "adapt", "show_secondary_image": false, "show_vendor": false, "show_rating": false, "enable_quick_add": false, "columns_mobile": "2", "swipe_on_mobile": true, "padding_top": 0, "padding_bottom": 36}}, "1668500027a509409d": {"type": "apps", "blocks": {"5a8947ac-3258-44c8-b3fd-bf2720e27444": {"type": "shopify://apps/yotpo-product-reviews/