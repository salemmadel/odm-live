.</p>", "page": ""}}, "50818e95-9033-4257-bbc6-e12f058849ab": {"type": "collapsible_tab", "settings": {"heading": "Allergen-Hinweis", "icon": "dairy_free", "content": "<p>Enthält Milch und Milcherzeugnisse.</p>", "page": ""}}, "collapsible-row-1": {"type": "collapsible_tab", "settings": {"heading": "Komm in die O'Donnell Gang", "icon": "silhouette", "content": "<p>Werde Teil der <a href=\"/pages/gang\" title=\"Die O'Donnell Gang\">Moonshine-Gang</a>! Als Mitglied sammelst du mit jedem Kauf im Onlineshop Proof und kannst diese gegen gratis O’Donnell Geschenke eintauschen. Außerdem hast du Zugang zu exklusiven Produkten und kannst im Gang-Rang immer weiter aufsteigen. Worauf wartest du also noch?</p>", "page": ""}}, "collapsible-row-0": {"type": "collapsible_tab", "settings": {"heading": "Versand", "icon": "truck", "content": "<ul><li><strong>DHL Priority: Lieferzeit 1-2 Werktage</strong></li></ul><p>Alle Bestellungen bis 12 Uhr werden noch am selben Tag DHL übergeben.</p><ul><li><strong>DHL Standard: Lieferzeit 2-3 Werktage</strong></li></ul>", "page": ""}}, "availability_message": {"type": "availability_message", "settings": {"show_availability_message": true, "availability_text": "Available from now"}}}, "block_order": ["vendor", "title", "caption", "1b158f69-6012-451e-bf40-a205c86b3682", "price", "variant_picker", "fd35310f-a903-4f2a-aa78-92f345583144", "quantity_selector", "availability_message", "buy_buttons", "description", "collapsible-row-2", "50818e95-9033-4257-bbc6-e12f058849ab", "collapsible-row-1", "collapsible-row-0"], "settings": {"gift_card_receipient_enabled": false, "is_above_the_fold": true, "enable_sticky_info": true, "gallery_layout": "thumbnail", "media_size": "medium", "mobile_thumbnails": "hide", "hide_variants": true, "enable_video_looping": false, "padding_top": 36, "padding_bottom": 12}}, "4c2c6503-4c54-4683-a418-84c2261ab62b": {"type": "rich-text", "blocks": {"template--18524875620620__4c2c6503-4c54-4683-a418-84c2261ab62b-button-1": {"type"