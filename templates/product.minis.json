{"sections": {"main": {"type": "main-product", "blocks": {"title": {"type": "title", "settings": {}}, "caption": {"type": "text", "settings": {"text": "{{ product.metafields.descriptors.subtitle.value }}", "text_style": "subtitle"}}, "44d472f1-8949-4815-ae48-0a6b4f206ada": {"type": "shopify://apps/yotpo-product-reviews/blocks/star-rating/eb7dfd7d-db44-4334-bc49-c893b51b36cf", "settings": {"product": "{{product}}"}}, "price": {"type": "price", "settings": {}}, "description": {"type": "description", "settings": {}}, "variant_picker": {"type": "variant_picker", "settings": {"picker_type": "button"}}, "quantity_selector": {"type": "quantity_selector", "disabled": true, "settings": {}}, "buy_buttons": {"type": "buy_buttons", "settings": {"show_sticky_cart": true, "is_set": false, "only_tier_gang_button": "Required gang tier not reached", "set_size": 3, "set_text": "Wähle 3 Produkte", "show_dynamic_checkout": false, "gang_url": ""}}, "wishlist_engine_product_page_nY69gq": {"type": "shopify://apps/se-wishlist-engine/blocks/Product-Page/8f7c0857-8e71-463d-a168-8e133094753b", "settings": {}}, "collapsible_tab_8FkAVc": {"type": "collapsible_tab", "disabled": true, "settings": {"heading": "So funktioniert der Deal", "icon": "price_tag", "content": "<p>Einfach wie gewohnt shoppen und die gewünschten Artikel in den Warenkorb legen. Ab <strong>59,90€</strong> gibt es ein <strong>kostenloses Mini Set</strong>! Solltest du den Mindestbestellwert von <strong>120€</strong> erreichen, bekommst du zusätzlich eine <strong>kostenlose Nut Cream</strong> on top! <strong>Die Produkte werden</strong> <strong>automatisch deinem Warenkorb hinzugefügt</strong>! Die Aktion ist bis Montag, 24.02. 10:00 gültig, aber nur für 300 Bestellungen! Viel Spaß beim Stöbern!</p><p><em>Der Deal ist nicht mit anderen Aktionen und Rabattcodes kombinierbar.</em></p>", "page": ""}}, "collapsible-row-0": {"type": "collapsible_tab", "settings": {"heading": "Beschreibung", "icon": "clipboard", "content": "<p>Das beliebte <strong>O'Donnell Moonshine</strong> Design in Miniaturgröße: 4 unterschiedliche Sets mit kleinen Mason Jars- verschiedene Geschmacksrichtungen und immer ein absoluter Genuss! Der beste <strong>Likör</strong> direkt aus Berlin, nach der Tradition der Gangster während der amerikanischen Prohibition hergestellt.<br/><br/>Wenn du noch mehr <a href=\"https://odonnell.de/\" title=\"Premium Liköre von O'Donnell Moonshine\">hochwertigen Likör</a> entdecken möchtest, wirf einfach einen Blick auf unsere anderen vielfältigen Moonshine-Produkte und werde Teil der <a href=\"/pages/gang\" title=\"Die O'Donnell Gang\">Moonshine-Gang</a>. Wir schmuggeln dir den Schnaps direkt nach Hause — völlig legal natürlich!</p>", "page": ""}}, "collapsible-row-1": {"type": "collapsible_tab", "settings": {"heading": "Inhalt", "icon": "box", "content": "<p>In jedem Mini Set befinden sich 4x50ml Moonshines</p><ul><li>\"<strong>Bestseller Minis\"</strong>: 2x Harte Nuss & 2x Toffee</li><li><strong>\"Classic Minis\"</strong>: Toffee, Pralle Kirsche, Harte Nuss & Wilde Beere</li><li><strong>\"Special Minis\":</strong> Wilde Beere, Harte Nuss, Toffee & Pralle Kirsche im bunten <strong>Birthday-Design</strong>!</li><li><strong>\"Winter Minis\"</strong>: Harte Nuss, Macadamia, Bratapfel & Toffee</li></ul>", "page": ""}}, "collapsible-row-2": {"type": "collapsible_tab", "settings": {"heading": "Cocktailvorschläge", "icon": "bottle", "content": "<p>Unsere <strong>Moonshine</strong> Minis sind der Hingucker und und ein ganz besonderes <strong>Geschenk</strong>. Hier treffen geniales Design und einzigartiger Geschmack aufeinander. Natürlich kommen unsere kleinen Liköre auch auf <strong>jeder Party</strong> super an, egal ob pur oder als leckerer <a href=\"/blogs/cocktails\" title=\"Cocktails\">Moonshine Cocktail</a>.</p>", "page": ""}}, "collapsible-row-3": {"type": "collapsible_tab", "settings": {"heading": "Versand", "icon": "truck", "content": "<ul><li><strong>DHL Priority: Lieferzeit 1-2 Werktage</strong></li></ul><p>Alle Bestellungen bis 12 Uhr werden noch am selben Tag DHL übergeben.</p><ul><li><strong>DHL Standard: Lieferzeit 2-3 Werktage</strong></li></ul>", "page": ""}}, "recommended_products_U7yU7Y": {"type": "recommended_products", "settings": {"title": "Dein bester Abend: Premium Auswahl nur für dich!", "content": "", "button_text": "Add all to cart", "product_list": ["harte-nuss-cream", "harte-nuss", "pralle-kirsche-kirschlikoer", "bratapfel"], "enable_bulk_add": false, "columns_desktop": "2", "enable_desktop_slider": true, "columns_mobile": "2", "swipe_on_mobile": true}}, "availability_message": {"type": "availability_message", "settings": {"show_availability_message": true, "availability_text": "Available from now"}}}, "block_order": ["title", "caption", "44d472f1-8949-4815-ae48-0a6b4f206ada", "price", "description", "variant_picker", "quantity_selector", "availability_message", "buy_buttons", "wishlist_engine_product_page_nY69gq", "collapsible_tab_8FkAVc", "collapsible-row-0", "collapsible-row-1", "collapsible-row-2", "collapsible-row-3", "recommended_products_U7yU7Y"], "settings": {"gift_card_receipient_enabled": false, "is_above_the_fold": true, "enable_sticky_info": true, "badges_enabled": false, "gallery_layout": "thumbnail", "media_size": "small", "mobile_thumbnails": "hide", "hide_variants": true, "enable_video_looping": false, "padding_top": 24, "padding_bottom": 12}}, "custom_liquid_WzcMgd": {"type": "custom-liquid", "settings": {"custom_liquid": "<div\n\tclass=\"yotpo yotpo-pictures-widget\"\n\tdata-gallery-id=\"66150cd80628020014a9c1bf\"\n\tdata-product-id=\"{{ product.id }}\">\n</div>", "color_scheme": "background-1", "padding_top": 24, "padding_bottom": 24}}, "featured_collection_iwF744": {"type": "featured-collection", "settings": {"is_above_the_fold": false, "title": "Ausgewählt für dich - nicht verpassen!", "heading_size": "h2", "description": "", "show_description": false, "grey_sold_out_products": true, "description_style": "b