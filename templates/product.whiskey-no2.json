{"sections": {"main": {"type": "main-product", "blocks": {"vendor": {"type": "text", "disabled": true, "settings": {"text": "{{ product.vendor }}", "text_style": "uppercase"}}, "title": {"type": "title", "settings": {}}, "caption": {"type": "text", "settings": {"text": "{{ product.metafields.descriptors.subtitle.value }}", "text_style": "subtitle"}}, "1b158f69-6012-451e-bf40-a205c86b3682": {"type": "shopify://apps/yotpo-product-reviews/blocks/star-rating/eb7dfd7d-db44-4334-bc49-c893b51b36cf", "disabled": true, "settings": {"product": "{{product}}"}}, "price": {"type": "price", "settings": {}}, "variant_picker": {"type": "variant_picker", "settings": {"picker_type": "button"}}, "quantity_selector": {"type": "quantity_selector", "disabled": true, "settings": {}}, "buy_buttons": {"type": "buy_buttons", "settings": {"show_sticky_cart": true, "is_set": false, "only_tier_gang_button": "NUR FÜR BOOTLEGGER- & CHIEF-GANGMITGLIEDER", "set_size": 3, "set_text": "Wähle 3 Produkte", "show_dynamic_checkout": false, "gang_url": "https://odonnell.de/account/login"}}, "description": {"type": "description", "settings": {}}, "collapsible-row-2": {"type": "collapsible_tab", "settings": {"heading": "Beschreibung", "icon": "clipboard", "content": "<p>Guter Whiskey war schon zur Zeit der Prohibition ein rares Gut – und genau so exklusiv ist unser <strong>Spike’s Big Catch No.2 </strong>heute. <strong>Ein starker Bourbon mit 43% Vol., abgefüllt in einer einzigartigen O’Donnell Whiskey-Flasche, die sonst nicht erhältlich ist. </strong>Tief im Lager haben wir eine kleine Charge dieses besonderen Tropfens entdeckt – <strong>B-Ware mit kleinen Makeln am Etikett, aber unverändert großem Charakter. </strong>Ein Whiskey, der in keine Massenproduktion passt, sondern für echte Kenner gemacht ist.</p>", "page": ""}}, "collapsible-row-1": {"type": "collapsible_tab", "settings": {"heading": "Komm in die O'Donnell Gang", "icon": "silhouette", "content": "<p>Werde Teil der <a href=\"/pages/gang\" title=\"Die O'Donnell Gang\">Moonshine-Gang</a>! Als Mitglied sammelst du mit jedem Kauf im Onlineshop Proof und kannst diese gegen gratis O’Donnell Geschenke eintauschen. Außerdem hast du Zugang zu exklusiven Produkten und kannst im Gang-Rang immer weiter aufsteigen. Worauf wartest du also noch?</p>", "page": ""}}, "collapsible-row-0": {"type": "collapsible_tab", "settings": {"heading": "Versand", "icon": "truck", "content": "<ul><li><strong>DHL Priority: Lieferzeit 1-2 Werktage</strong></li></ul><p>Alle Bestellungen bis 12 Uhr werden noch am selben Tag DHL übergeben.</p><ul><li><strong>DHL Standard: Lieferzeit 2-3 Werktage</strong></li></ul>", "page": ""}}, "recommended_products_gnKthG": {"type": "recommended_products", "settings": {"title": "Empfohlene Produkte", "content": "", "button_text": "", "product_list": ["cream-bundle", "harte-nuss", "pralle-kirsche-kirschlikoer", "harte-nuss-und-cream-bundle"], "enable_bulk_add": false, "columns_desktop": "2", "enable_desktop_slider": true, "columns_mobile": "2", "swipe_on_mobile": true}}, "availability_message": {"type": "availability_message", "settings": {"show_availability_message": true, "availability_text": "Available from now"}}}, "block_order": ["vendor", "title", "caption", "1b158f69-6012-451e-bf40-a205c86b3682", "price", "variant_picker", "quantity_selector", "availability_message", "buy_buttons", "description", "collapsible-row-2", "collapsible-row-1", "collapsible-row-0", "recommended_products_gnKthG"], "settings": {"gift_card_receipient_enabled": false, "is_above_the_fold": true, "enable_sticky_info": true, "gallery_layout": "thumbnail", "media_size": "medium", "mobile_thumbnails": "hide", "hide_variants": true, "enable_video_looping": false, "padding_top": 24, "padding_bottom": 12}}, "image-with-text": {"type": "image-with-text", "blocks": {"image-with-text-0": {"type": "heading", "settings": {"heading": "Der nächste Whiskey in der O’Donnell-Historie!", "heading_size": "h2"}}, "image-with-text-1": {"type": "text", "settings": {"text": "<p>Unser Whiskey geht in die zweite Runde! Nachdem bereits unser Chief-exklusiver \"Spike's Big Catch\" große Popularität genoss, beschlossen wir einen neuen Hochprozentigen für euch zu brennen. <strong>Für alle Gang-Member verfügbar</strong>, also greift schnell zu, denn wir können nicht garantieren, dass alle einen Bourbon Whiskey erhalten!</p>", "text_style": "body"}}}, "block_order": ["image-with-text-0", "image-with-text-1"], "settings": {"is_above_the_fold": false, "background_color": "#000000", "text_color": "#000000", "image": "shopify://shop_images/WhiskeyNo2_Detail.jpg", "image_caption": "", "height": "adapt", "desktop_image_width": "medium", "layout": "text_first", "desktop_content_position": "middle", "desktop_content_alignment": "left", "content_layout": "overlap", "color_scheme": "background-2", "mobile_content_alignment": "left", "padding_top": 36, "padding_bottom": 12}}, "f1ea0866-fcfa-41f3-8ae9-84fae6d01566": {"type": "image-with-text", "blocks": {"template--17963898274060__f1ea0866-fcfa-41f3-8ae9-84fae6d01566-1684837189c45d6eeb-0": {"type": "heading", "settings": {"heading": "Einzigartiger Genuss, einzigartige Verpackung", "heading_size": "h2"}}, "template--17963898274060__f1ea0866-fcfa-41f3-8ae9-84fae6d01566-1684837189c45d6eeb-1": {"type": "text", "settings": {"text": "<p>Aromen von <strong>Karamell, Kokosnuss, Vanille und Kräutern</strong> verfeinern die angenehm-weiche Basis des drei Jahre gereiften Whiskeys. Um diesen besonderen Geschmack gebührend zu verpacken, haben wir eine nie dagewesene O'Donnell Whiskeyflasche entworfen. Schlägt sich sowohl im Gaumen als auch in der Vitrine gut.</p>", "text_style": "body"}}}, "block_order": ["template--17963898274060__f1ea0866-fcfa-41f3-8ae9-84fae6d01566-1684837189c45d6eeb-0", "template--17963898274060__f1ea0866-fcfa-41f3-8ae9-84fae6d01566-1684837189c45d6eeb-1"], "settings": {"is_above_the_fold": false, "background_color": "#000000", "text_color": "#000000", "image": "shopify://shop_images/WhiskeyNo2_Mood.jpg", "image_caption": "", "height": "adapt", "desktop_image_width": "medium", "layout": "image_first", "desktop_content_position": "middle", "desktop_content_alignment": "left", "content_layout": "overlap", "color_scheme": "background-2", "mobile_content_alignment": "left", "padding_top": 12, "padding_bottom": 12}}, "0fd799eb-f35b-4cd3-80fc-25443bd6f860": {"type": "image-with-text", "blocks": {"template--17975344759052__0fd799eb-f35b-4cd3-80fc-25443bd6f860-16856082870b7a0249-0": {"type": "heading", "settings": {"heading": "Du bist noch kein Gang-Mitglied?", "heading_size": "h2"}}, "template--17975344759052__0fd799eb-f35b-4cd3-80fc-25443bd6f860-16856082870b7a0249-1": {"type": "text", "settings": {"text": "<p>Unser \"Spike's Big Catch No. 2\" ist nur ein Beispiel von vielen exklusiven Angeboten und Vorteilen für unsere Gang-Mitglieder! Erfahre mehr über die O’Donnell Gang hier.</p>", "text_style": "body"}}, "template--17975344759052__0fd799eb-f35b-4cd3-80fc-25443bd6f860-16856082870b7a0249-2": {"type": "button", "settings": {"button_label": "Zur Gang-Seite", "button_link": "shopify://pages/gang", "button_style_white_color": false}}}, "block_order": ["template--17975344759052__0fd799eb-f35b-4cd3-80fc-25443bd6f860-16856082870b7a0249-0", "template--17975344759052__0fd799eb-f35b-4cd3-80fc-25443bd6f860-16856082870b7a0249-1", "template--17975344759052__0fd799eb-f35b-4cd3-80fc-25443bd6f860-16856082870b7a0249-2"], "settings": {"is_above_the_fold": false, "background_color": "#000000", "text_color": "#000000", "image": "shopify://shop_images/Gang_Hero_Mobil_1.jpg", "image_caption": "", "height": "adapt", "desktop_image_width": "medium", "layout": "text_first", "desktop_content_position": "middle", "desktop_content_alignment": "left", "content_layout": "overlap", "color_scheme": "background-2", "mobile_content_alignment": "left", "padding_top": 12, "padding_bottom": 24}}, "product-recommendations": {"type": "product-recommendations", "settings": {"heading": "Das könnte Dir auch gefallen", "heading_size": "h2", "products_to_show": 4, "columns_desktop": 4, "color_scheme": "background-1", "image_ratio": "square", "show_secondary_image": true, "show_vendor": false, "show_rating": false, "grey_sold_out_products": true, "columns_mobile": "2", "padding_top": 24, "padding_bottom": 12}}, "1668500027a509409d": {"type": "apps", "blocks": {"ffd20876-ff57-40f0-8f6d-e626c144826d": {"type": "shopify://apps/yotpo-product-reviews/blocks/reviews/eb7dfd7d-db44-4334-bc49-c893b51b36cf", "settings": {"product": "{{product}}"}}}, "block_order": ["ffd20876-ff57-40f0-8f6d-e626c144826d"], "settings": {"include_margins": true}}}, "order": ["main", "image-with-text", "f1ea0866-fcfa-41f3-8ae9-84fae6d01566", "0fd799eb-f35b-4cd3-80fc-25443bd6f860", "product-recommendations", "1668500027a509409d"]}