    {%- if settings.enable_wishlist -%}
      {%- if settings.wishlist_exclude != blank -%}
        <script>
        try {
          window.fetch = new Proxy(window.fetch, {
            apply(fetch, that, args) {
              let result = fetch.apply(that, args);
              return result.then((response) => {
                if (args[0].search && args[0].search(/apps-wishlist/) >= 0) {
                  var intervalVar = setInterval(function() {
                    if (document.querySelector('.wishlist-cart')) {
                      [{{settings.wishlist_exclude}}].forEach(function(object) {
                        document.querySelector('.wishlist-cart[data-product_id="' + object + '"]')?.remove()
                      })
                      clearInterval(intervalVar);
                    }
                  }, 50);
                }
              }), result
            }
          });
        } catch (A) {
          console.log(A), console.log("error catching cart fetch")
        }
      </script>
    {%- endif -%}
    <script>
     function createAndDispatchCustomEvent (eventName, bubbles) {
      const event = new Event(eventName, { bubbles })
      document.dispatchEvent(event)
    }
        
    function getSectionInnerHTML (html, selector) {
        return new DOMParser()
          .parseFromString(html, 'text/html')
          .querySelector(selector)?.innerHTML
    }
    window.wishlistEngineCallback = async function(cartChangeState){
      await fetch(`${window.routes.cartUrl}` + '?sections=main-cart-items')
        .then(response => response.json())
        .then((response) => {
          const parsedState = cartChangeState;
          if (!parsedState) return

          const cartNotification = document.querySelector('cart-notification')

          if (cartNotification) {
            const res = response['main-cart-items']
            if (!res) return

            const parsedReponse = new DOMParser().parseFromString(res, 'text/html').body.querySelector('[id=main-cart-items]')
            const productsContainer = cartNotification.querySelector('.cart-notification-products')

            if (productsContainer) {
              productsContainer.innerHTML = ''
              productsContainer.appendChild(parsedReponse)
            }

            if (document.querySelector('#drawer_cart_item_count')) {
              if (!parsedState.item_count) {
                const itemCount = new DOMParser().parseFromString(parsedState.sections['cart-notification'], 'text/html').querySelector('#drawer_cart_item_count').innerHTML
                document.querySelector('#drawer_cart_item_count').innerHTML = itemCount
              } else {
                document.querySelector('#drawer_cart_item_count').innerHTML = parsedState.item_count
              }
            }

            if (!document.querySelector('#cart-notification').classList.contains('active')) {
              createAndDispatchCustomEvent('drawer:open', true)
            }

            createAndDispatchCustomEvent('addToCart:finished', true)
          } 
             ([
                {
                    "id": "cart-icon-bubble",
                    "section": "cart-icon-bubble",
                    "selector": ".shopify-section"
                },
                {
                    "id": "cart-notification",
                    "section": "cart-notification",
                    "selector": ".cart-notification__links"
                },
                {
                    "id": "cart-notification",
                    "section": "cart-notification",
                    "selector": ".js-contents"
                },
                {
                    "id": "cart-notification",
                    "section": "cart-notification",
                    "selector": ".free-products"
                }
            ]).map(section => {
                          const elementToReplace = document.getElementById(section.id).querySelector(section.selector) || document.getElementById(section.id)
                          const replacement = getSectionInnerHTML(parsedState.sections[section.section], section.selector);
                          if(replacement){
                            const replace = elementToReplace.innerHTML = replacement
                            return replace
                          }
                        })
          

        

         })
        .catch((e) => {
          console.error(e)
        })
    }
  </script>
  {%- endif -%}
  
  </body>
</html>
